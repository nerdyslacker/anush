#!/usr/bin/env python3
"""Generate and apply a cohesive desktop palette from a wallpaper."""

import colorsys
import json
import math
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys


def clamp(value, low, high):
    return max(low, min(high, value))


def hue_distance(a, b):
    distance = abs(a - b) % 360
    return 360 - distance if distance > 180 else distance


def hex_color(hue, saturation, lightness):
    red, green, blue = colorsys.hls_to_rgb((hue % 360) / 360, lightness, saturation)
    return f"#{round(red * 255):02x}{round(green * 255):02x}{round(blue * 255):02x}"


def blend(first, second, amount):
    """Blend two #RRGGBB colors; amount is the share of second."""
    left = tuple(int(first[index:index + 2], 16) for index in (1, 3, 5))
    right = tuple(int(second[index:index + 2], 16) for index in (1, 3, 5))
    mixed = (round(a * (1 - amount) + b * amount)
             for a, b in zip(left, right))
    return "#" + "".join(f"{channel:02x}" for channel in mixed)


def darken(color, factor):
    red, green, blue = (int(color[index:index + 2], 16) / 255
                        for index in (1, 3, 5))
    hue, lightness, saturation = colorsys.rgb_to_hls(red, green, blue)
    return hex_color(hue * 360, saturation, lightness / factor)


def relative_luminance(color):
    channels = [int(color[index:index + 2], 16) / 255 for index in (1, 3, 5)]
    linear = [channel / 12.92 if channel <= 0.04045
              else ((channel + 0.055) / 1.055) ** 2.4
              for channel in channels]
    return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2]


def ensure_contrast(color, background, target=4.5):
    background_luminance = relative_luminance(background)
    adjusted = color
    for _ in range(24):
        foreground_luminance = relative_luminance(adjusted)
        ratio = ((max(background_luminance, foreground_luminance) + 0.05)
                 / (min(background_luminance, foreground_luminance) + 0.05))
        if ratio >= target:
            return adjusted
        adjusted = darken(adjusted, 1.06)
    return adjusted


def wallpaper_light_background(color):
    """Lift the wallpaper's dominant background hue into a usable light tone."""
    red, green, blue = (int(color[index:index + 2], 16) / 255
                        for index in (1, 3, 5))
    hue, _, saturation = colorsys.rgb_to_hls(red, green, blue)
    # Near-neutral wallpapers stay neutral; colorful wallpapers retain enough
    # chroma to feel derived from the image instead of default Srcery cream.
    lifted_saturation = clamp(saturation * 1.2, 0.04, 0.30)
    return hex_color(hue * 360, lifted_saturation, 0.90)


def valid_hex(value):
    return isinstance(value, str) and bool(
        re.fullmatch(r"#[0-9a-fA-F]{6}", value))


def matugen_colors(payload, mode):
    """Normalize both scheme-first and role-first Matugen JSON layouts."""
    colors = payload.get("colors", {}) if isinstance(payload, dict) else {}
    if not isinstance(colors, dict):
        return None
    scheme = colors.get(mode)
    if isinstance(scheme, dict):
        normalized = {key: value.lower() for key, value in scheme.items()
                      if valid_hex(value)}
    else:
        normalized = {}
        for role, variants in colors.items():
            if not isinstance(variants, dict):
                continue
            value = variants.get(mode)
            if isinstance(value, dict):
                value = value.get("hex") or value.get("color")
            if valid_hex(value):
                normalized[role] = value.lower()
    required = {"background", "on_background", "surface", "on_surface",
                "primary", "on_primary", "secondary", "tertiary", "error",
                "outline", "outline_variant"}
    return normalized if required.issubset(normalized) else None


def shifted_color(color, degrees, lightness_shift=0):
    red, green, blue = (int(color[index:index + 2], 16) / 255
                        for index in (1, 3, 5))
    hue, lightness, saturation = colorsys.rgb_to_hls(red, green, blue)
    return hex_color(hue * 360 + degrees, max(0.32, saturation),
                     clamp(lightness + lightness_shift, 0.35, 0.82))


def palette_from_matugen(image, mode):
    executable = shutil.which("matugen")
    if not executable:
        return None
    root = Path(__file__).resolve().parent.parent.parent
    config = Path(os.environ.get(
        "ANUSH_CONFIG_DIR", root / "config")) / "matugen/config.toml"
    command = [executable, "image", image, "--json", "hex", "-m", mode,
               "-t", "scheme-tonal-spot", "-c", str(config)]
    try:
        process = subprocess.run(command, check=False, capture_output=True,
                                 text=True, timeout=45)
        if process.returncode != 0:
            detail = process.stderr.strip().splitlines()
            message = detail[-1] if detail else f"exit {process.returncode}"
            print(f"generate-wallpaper-theme: Matugen failed ({message}); "
                  "using built-in generator", file=sys.stderr)
            return None
        output = process.stdout.strip()
        start, end = output.find("{"), output.rfind("}")
        if start < 0 or end < start:
            raise ValueError("no JSON object in output")
        material = matugen_colors(json.loads(output[start:end + 1]), mode)
        if not material:
            raise ValueError("palette is missing required Material roles")
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError,
            ValueError) as error:
        print(f"generate-wallpaper-theme: cannot use Matugen ({error}); "
              "using built-in generator", file=sys.stderr)
        return None

    surface_alt = material.get("surface_container",
                               material.get("surface_variant", material["surface"]))
    foreground_muted = material.get("on_surface_variant", material["on_surface"])
    semantic = {
        "background": material["background"],
        "background-alt": surface_alt,
        "foreground": material["on_background"],
        "border": material["outline"],
        "primary": material["primary"],
        "secondary": material["secondary"],
        "alert": material["error"],
        "disabled": material["outline_variant"],
    }
    primary = material["primary"]
    green = shifted_color(primary, 105)
    yellow = shifted_color(primary, 55)
    magenta = shifted_color(primary, -65)
    cyan = shifted_color(primary, 165)
    ansi = [
        surface_alt, material["error"], green, yellow, primary, magenta, cyan,
        foreground_muted, material["outline"],
        material.get("error_container", material["error"]),
        shifted_color(green, 0, 0.08), shifted_color(yellow, 0, 0.08),
        material.get("primary_fixed", shifted_color(primary, 0, 0.08)),
        shifted_color(magenta, 0, 0.08), shifted_color(cyan, 0, 0.08),
        material["on_surface"],
    ]
    return semantic, ansi, material


def palette_for_mode(semantic, ansi, mode, preserve_primary=False):
    if mode != "light":
        return semantic, ansi

    cream = "#FCE8C3"
    ink = "#121110"
    background = (cream if preserve_primary
                  else wallpaper_light_background(semantic["background"]))
    light_semantic = {
        "background": background,
        "background-alt": blend(background, ink, 0.065),
        "foreground": ink,
        "border": blend(background, ink, 0.32),
        "primary": semantic["primary"] if preserve_primary
                   else darken(semantic["primary"], 1.35),
        "secondary": darken(semantic["secondary"], 1.28),
        "alert": darken(semantic["alert"], 1.28),
        "disabled": blend(ink, background, 0.42),
    }
    for role in ("primary", "secondary", "alert"):
        light_semantic[role] = ensure_contrast(light_semantic[role], background)
    factors = [1, 1.28, 1.35, 1.65, 1.25, 1.28, 1.38, 1]
    light_ansi = [light_semantic["background-alt"]]
    light_ansi.extend(darken(ansi[index], factors[index]) for index in range(1, 7))
    light_ansi.append(blend(ink, background, 0.22))
    light_ansi.append(blend(ink, background, 0.42))
    bright_factors = [1.35, 1.45, 1.75, 1.28, 1.38, 1.48]
    light_ansi.extend(darken(ansi[index + 9], bright_factors[index])
                      for index in range(6))
    light_ansi.append(ink)
    for index in list(range(1, 7)) + list(range(9, 15)):
        light_ansi[index] = ensure_contrast(light_ansi[index], background)
    return light_semantic, light_ansi


def palette_from(image):
    raw = subprocess.check_output([
        "magick", image, "-auto-orient", "-resize", "96x54!",
        "-depth", "8", "rgba:-",
    ])
    bins = {}
    total = 0
    for offset in range(0, len(raw), 4):
        red, green, blue, alpha = raw[offset:offset + 4]
        if alpha < 200:
            continue
        total += 1
        key = (red >> 4, green >> 4, blue >> 4)
        entry = bins.setdefault(key, [0, 0, 0, 0])
        entry[0] += 1
        entry[1] += red
        entry[2] += green
        entry[3] += blue
    if not total:
        raise RuntimeError("wallpaper has no opaque pixels")

    clusters = []
    for count, red, green, blue in bins.values():
        hue, lightness, saturation = colorsys.rgb_to_hls(
            red / count / 255, green / count / 255, blue / count / 255)
        clusters.append({"n": count, "h": hue * 360, "s": saturation, "l": lightness})
    clusters.sort(key=lambda color: color["n"], reverse=True)
    dominant = clusters[:40]
    art = sum(color["n"] for color in dominant[:8]) / total > 0.85

    background = max(dominant, key=lambda color: color["n"] * (1.15 - color["l"]))
    bg_h = background["h"]
    bg_s = min(background["s"], 0.35 if art else 0.26)
    bg_l = (clamp(background["l"], 0.09, 0.20) if art
            else clamp(background["l"] * 0.7, 0.10, 0.17))

    beacons = [color for color in clusters
               if color["s"] >= 0.15 and color["l"] >= background["l"] + 0.3
               and hue_distance(color["h"], bg_h) >= 50]
    beacon = None
    if beacons:
        seed = max(beacons, key=lambda color: color["l"] * color["n"])
        family = [color for color in beacons if hue_distance(color["h"], seed["h"]) <= 30]
        count = sum(color["n"] for color in family)
        if 0.0005 <= count / total <= 0.02:
            beacon = {
                "n": count, "h": seed["h"],
                "s": max(sum(c["s"] * c["n"] for c in family) / count, 0.45),
                "l": sum(c["l"] * c["n"] for c in family) / count,
            }

    primary = beacon
    if primary is None:
        candidates = [color for color in dominant if color["s"] > 0.15]
        primary = max(candidates, default=None, key=lambda color:
                      color["s"] ** 1.5 * math.sqrt(color["n"] / total)
                      * (1 if 0.15 < color["l"] < 0.85 else 0.2))
    pri_h = primary["h"] if primary else bg_h
    pri_s = (clamp(primary["s"], 0.30, 0.85 if art else 0.55)
             if primary else 0.15)
    pri_l = (clamp(primary["l"], 0.45 if art else 0.62, 0.75 if art else 0.78)
             if primary else 0.70)

    secondary_candidates = [color for color in dominant
                            if color["s"] >= 0.2 and hue_distance(color["h"], pri_h) >= 45]
    secondary = max(secondary_candidates, default=None,
                    key=lambda color: color["s"] * math.sqrt(color["n"] / total))
    sec_h = secondary["h"] if secondary else pri_h + 35
    sec_s = (clamp(secondary["s"], 0.25 if art else 0.20, 0.75 if art else 0.40)
             if secondary else pri_s * 0.7)
    sec_l = (clamp(secondary["l"], 0.45 if art else 0.70, 0.80)
             if secondary else 0.74)

    reds = [color for color in dominant
            if (color["h"] <= 20 or color["h"] >= 340) and color["s"] > 0.35]
    alert_cluster = max(reds, default=None, key=lambda color: color["n"])
    alert = (hex_color(alert_cluster["h"], clamp(alert_cluster["s"], 0.4, 0.8),
                       clamp(alert_cluster["l"], 0.5, 0.65)) if alert_cluster
             else hex_color(4, 0.4, 0.66))
    fg_h = next((color["h"] for color in dominant
                 if 20 <= color["h"] <= 60 and color["l"] > 0.3), 42)

    semantic = {
        "background": hex_color(bg_h, bg_s, bg_l),
        "background-alt": hex_color(bg_h, bg_s, bg_l + 0.06),
        "foreground": hex_color(fg_h, 0.2, 0.78),
        "border": hex_color(pri_h, 0.18, bg_l + 0.10),
        "primary": hex_color(pri_h, pri_s, pri_l),
        "secondary": hex_color(sec_h, sec_s, sec_l),
        "alert": alert,
        "disabled": hex_color(bg_h, 0.1, 0.4),
    }

    terms = [None] * 6
    terms[0] = alert_cluster or {"h": 4, "s": 0.4, "l": 0.66, "n": 1}
    anchors = [(1, 120), (2, 55), (3, 225), (4, 300), (5, 180)]
    candidates = sorted(
        [color for color in dominant if color["s"] > 0.2 and 0.15 < color["l"] < 0.85
         and hue_distance(color["h"], terms[0]["h"]) >= 30],
        key=lambda color: color["s"] * math.sqrt(color["n"]), reverse=True)[:8]
    for _ in anchors:
        match = None
        for slot, anchor in anchors:
            if terms[slot] is not None:
                continue
            for index, color in enumerate(candidates):
                if color is None:
                    continue
                distance = hue_distance(color["h"], anchor)
                if distance < 46 and (match is None or distance < match[0]):
                    match = (distance, slot, index)
        if match is None:
            break
        _, slot, index = match
        terms[slot] = candidates[index]
        candidates[index] = None
    for slot, anchor in anchors:
        if terms[slot] is None:
            terms[slot] = {"h": anchor, "s": 0.5 if art else 0.4, "l": 0.62}

    ansi = [None] * 16
    ansi[0] = hex_color(bg_h, bg_s, bg_l + 0.06)
    ansi[7] = hex_color(fg_h, 0.15, 0.72)
    ansi[8] = hex_color(bg_h, 0.1, 0.38)
    ansi[15] = hex_color(fg_h, 0.18, 0.86)
    for index, term in enumerate(terms):
        saturation = clamp(term["s"], 0.35, 0.8) if art else 0.4
        lightness = clamp(term["l"], 0.5, 0.7) if art else 0.66
        ansi[index + 1] = hex_color(term["h"], saturation, lightness)
        ansi[index + 9] = hex_color(term["h"], saturation if art else 0.42,
                                    min(lightness + 0.08, 0.78))
    return semantic, ansi


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(text)
    temporary.replace(path)


def apply_files(image, semantic, ansi, config_dir, state_file, mode,
                preserve_primary=False, generator="anush", material=None,
                mode_ready=False):
    if not mode_ready:
        semantic, ansi = palette_for_mode(
            semantic, ansi, mode, preserve_primary)
    data = {"image": image, "semantic": semantic, "ansi": ansi, "mode": mode,
            "generator": generator}
    if material:
        data["material"] = material
    atomic_write(config_dir / "rofi/colors.rasi", f"""/* Generated from wallpaper: {Path(image).name} */

* {{
    bg:          {semantic['background']};
    fg:          {semantic['foreground']};
    accent:      {semantic['primary']};
    accent-2:    {semantic['secondary']};
    border:      {semantic['primary']};
    urgent:      {semantic['alert']};
    selected-fg: {semantic['background']};
    entry-fg:    {semantic['secondary']};
    prompt-fg:   {semantic['primary']};
    header:      {semantic['secondary']};
    background-color: @bg;
}}
""")
    kitty = f"""# vim:ft=kitty
## name: Wallpaper — {Path(image).name}
foreground {semantic['foreground']}
background {semantic['background']}
selection_foreground {semantic['background']}
selection_background {semantic['primary']}
cursor {semantic['foreground']}
cursor_text_color {semantic['background']}
url_color {semantic['primary']}
active_border_color {semantic['primary']}
inactive_border_color {semantic['disabled']}
bell_border_color {semantic['alert']}
active_tab_foreground {semantic['background']}
active_tab_background {semantic['primary']}
inactive_tab_foreground {semantic['foreground']}
inactive_tab_background {semantic['background-alt']}
tab_bar_background {semantic['background']}
mark1_foreground {semantic['background']}
mark1_background {semantic['primary']}
mark2_foreground {semantic['background']}
mark2_background {semantic['alert']}
mark3_foreground {semantic['background']}
mark3_background {semantic['secondary']}
""" + "".join(f"color{index} {semantic['primary'] if index in (4, 12) else color}\n"
                for index, color in enumerate(ansi))
    atomic_write(config_dir / "kitty/current-theme.conf", kitty)

    dunst_path = config_dir / "dunst/dunstrc"
    if dunst_path.is_file() and os.access(dunst_path, os.W_OK):
        dunst = dunst_path.read_text()
        marker_colors = {
            "frame_global": semantic["primary"], "bg_low": semantic["background"],
            "fg_low": semantic["disabled"], "frame_low": semantic["primary"],
            "highlight_low": semantic["secondary"], "bg_normal": semantic["background"],
            "fg_normal": semantic["foreground"], "frame_normal": semantic["primary"],
            "highlight_normal": semantic["primary"], "bg_critical": semantic["background"],
            "fg_critical": semantic["foreground"], "frame_critical": semantic["alert"],
            "highlight_critical": semantic["alert"],
        }
        for marker, color in marker_colors.items():
            dunst = re.sub(rf'(^[^\n]*"?)#[0-9a-fA-F]{{6}}("?[^\n]*# THEME: dunst_{marker}$)',
                           rf'\g<1>{color}\2', dunst, flags=re.MULTILINE)
        atomic_write(dunst_path, dunst)

    config_paths = [config_dir / "skarwm/config.rc"]
    if os.environ.get("SKARWM_CONFIG"):
        config_paths.append(Path(os.environ["SKARWM_CONFIG"]))
    elif os.environ.get("XDG_CONFIG_HOME"):
        config_paths.append(
            Path(os.environ["XDG_CONFIG_HOME"]) / "skarwm/config.rc")
    elif os.environ.get("HOME"):
        config_paths.append(Path(os.environ["HOME"]) / ".config/skarwm/config.rc")
    for config_path in dict.fromkeys(config_paths):
        if not config_path.is_file() or not os.access(config_path, os.W_OK):
            continue
        config = config_path.read_text()
        config = re.sub(r'(?m)^(\s*norm_outer_border\s*:\s*)#[0-9a-fA-F]{6}',
                        rf'\g<1>{semantic["disabled"]}', config)
        config = re.sub(r'(?m)^(\s*sel_outer_border\s*:\s*)#[0-9a-fA-F]{6}',
                        rf'\g<1>{semantic["primary"]}', config)
        atomic_write(config_path, config)

    state = json.loads(state_file.read_text())
    state.setdefault("theme", {})["palette"] = data
    atomic_write(state_file, json.dumps(state, indent=2) + "\n")


def reload_components(wm_message=""):
    if os.environ.get("ANUSH_THEME_NO_RELOAD") == "1":
        return
    for process, sig in (("kitty", signal.SIGUSR1), ("dunst", signal.SIGHUP)):
        subprocess.run(["pkill", f"-{sig.value}", "-x", process], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    message = shutil.which(wm_message) if wm_message else None
    if not message:
        message = shutil.which("skarwm-msg")
    if message:
        subprocess.run([message, "reload"], check=False, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)


def main():
    arguments = sys.argv[1:]
    wm_message = ""
    if "--wm-msg" in arguments:
        option_index = arguments.index("--wm-msg")
        if option_index + 1 >= len(arguments):
            raise SystemExit("generate-wallpaper-theme: --wm-msg requires a value")
        wm_message = arguments[option_index + 1]
        del arguments[option_index:option_index + 2]

    root = Path(__file__).resolve().parent.parent.parent
    config_dir = Path(os.environ.get("ANUSH_CONFIG_DIR", root / "config"))
    default_state = Path(os.environ.get(
        "XDG_STATE_HOME", os.path.expanduser("~/.local/state"))) / "anush"
    state_dir = Path(os.environ.get("ANUSH_STATE_DIR", default_state))
    state_file = state_dir / "shell-state.json"
    preserve_primary = False
    if arguments and arguments[0] == "--default":
        mode = arguments[1] if len(arguments) >= 2 and arguments[1] in ("dark", "light") else "dark"
        accent_index = 2 if len(arguments) >= 2 and arguments[1] in ("dark", "light") else 1
        accent = arguments[accent_index] if len(arguments) > accent_index else "#FED06E"
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", accent):
            accent = "#FED06E"
        preserve_primary = True
        image = "Srcery"
        semantic = {
            "background": "#121110", "background-alt": "#262522",
            "foreground": "#FCE8C3", "border": "#3B3935",
            "primary": accent, "secondary": "#68A8E4",
            "alert": "#EF2F27", "disabled": "#504D47",
        }
        ansi = [
            "#121110", "#EF2F27", "#519F50", "#FBB829",
            "#2C78BF", "#E02C6D", "#0AAEB3", "#C5B088",
            "#917E6B", "#F75341", "#98BC37", "#FED06E",
            "#68A8E4", "#FF5C8F", "#2BE4D0", "#FCE8C3",
        ]
    elif arguments and Path(arguments[0]).is_file():
        mode = arguments[1] if len(arguments) >= 2 and arguments[1] in ("dark", "light") else "dark"
        image = str(Path(arguments[0]).resolve())
        generated = palette_from_matugen(image, mode)
        if generated:
            semantic, ansi, material = generated
            apply_files(image, semantic, ansi, config_dir, state_file, mode,
                        generator="matugen", material=material, mode_ready=True)
            reload_components(wm_message)
            return
        semantic, ansi = palette_from(image)
    else:
        raise SystemExit(
            "usage: generate-wallpaper-theme IMAGE [dark|light] | "
            "--default [dark|light] [ACCENT] [--wm-msg PATH]")
    apply_files(image, semantic, ansi, config_dir, state_file, mode,
                preserve_primary)
    reload_components(wm_message)


if __name__ == "__main__":
    main()
