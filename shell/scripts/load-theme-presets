#!/usr/bin/env python3

"""Load and validate Anush theme preset JSON files."""

from __future__ import annotations

import json
from pathlib import Path
import re
import sys


REQUIRED_COLORS = {
    "background", "surfaceSubtle", "surface", "surfaceVariant", "pressed",
    "outline", "disabled", "foreground", "foregroundMuted", "red",
    "orange", "yellow", "green", "cyan", "blue", "magenta", "teal",
    "shadow",
}
HEX_COLOR = re.compile(r"^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$")


def load(directory: Path) -> list[dict]:
    presets: list[dict] = []
    ids: set[str] = set()
    for path in sorted(directory.glob("*.json")):
        try:
            preset = json.loads(path.read_text())
            if not isinstance(preset, dict):
                raise ValueError("root must be an object")
            identifier = preset.get("id")
            if not isinstance(identifier, str) or not identifier:
                raise ValueError("id must be a non-empty string")
            if identifier in ids:
                raise ValueError(f"duplicate id {identifier!r}")
            if preset.get("mode") not in {"dark", "light"}:
                raise ValueError("mode must be dark or light")
            if not isinstance(preset.get("name"), str):
                raise ValueError("name must be a string")
            order = preset.get("order", 1000)
            if isinstance(order, bool) or not isinstance(order, (int, float)):
                raise ValueError("order must be a number")
            preview = preset.get("preview")
            if not isinstance(preview, list) or len(preview) < 3:
                raise ValueError("preview must contain at least three colors")
            if any(not isinstance(value, str) or not HEX_COLOR.fullmatch(value)
                   for value in preview):
                raise ValueError("preview contains an invalid color")
            colors = preset.get("colors")
            if not isinstance(colors, dict):
                raise ValueError("colors must be an object")
            missing = REQUIRED_COLORS.difference(colors)
            if missing:
                raise ValueError("missing colors: " + ", ".join(sorted(missing)))
            for key, value in colors.items():
                if not isinstance(value, str) or not HEX_COLOR.fullmatch(value):
                    raise ValueError(f"invalid color {key!r}: {value!r}")
            source = preset.get("source", {})
            if not isinstance(source, dict) or any(
                    not isinstance(value, str) or not HEX_COLOR.fullmatch(value)
                    for value in source.values()):
                raise ValueError("source contains an invalid color")
            ids.add(identifier)
            presets.append(preset)
        except (OSError, json.JSONDecodeError, ValueError) as error:
            print(f"{path}: {error}", file=sys.stderr)
    presets.sort(key=lambda item: (item.get("order", 1000), item["name"]))
    return presets


def main() -> int:
    if len(sys.argv) != 2:
        return 2
    print(json.dumps(load(Path(sys.argv[1])), separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
