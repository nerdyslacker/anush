#!/usr/bin/env python3
"""XRandR backend for Anush's normalized display configuration service."""

import json
import os
import re
import subprocess
import sys
import time
import uuid
from pathlib import Path


ROLLBACK_PATH = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "anush-display-rollback.json"
OUTPUT_RE = re.compile(
    r"^(\S+) connected(?P<primary> primary)?(?: (?P<w>\d+)x(?P<h>\d+)"
    r"(?P<x>[+-]\d+)(?P<y>[+-]\d+))?.*?(?:(?P<pw>\d+)mm x (?P<ph>\d+)mm)?$")
MODE_RE = re.compile(r"^\s+(\d+)x(\d+)\s+(.+)$")
RATE_RE = re.compile(r"(\d+(?:\.\d+)?)([*+]*)")


def xrandr(*args):
    return subprocess.run(["xrandr", *args], text=True, capture_output=True)


def enumerate_outputs():
    result = xrandr("--query")
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "xrandr query failed")
    outputs = []
    current = None
    for line in result.stdout.splitlines():
        match = OUTPUT_RE.match(line)
        if match:
            current = {
                "id": match.group(1), "name": match.group(1),
                "description": match.group(1), "connected": True,
                "enabled": match.group("w") is not None,
                "primary": match.group("primary") is not None,
                "make": "", "model": "", "serial": "",
                "physicalWidth": int(match.group("pw") or 0),
                "physicalHeight": int(match.group("ph") or 0),
                "x": int(match.group("x") or 0), "y": int(match.group("y") or 0),
                "width": int(match.group("w") or 0), "height": int(match.group("h") or 0),
                "refreshRate": 0.0,
                "scale": 1.0, "transform": "normal",
                "currentMode": None, "preferredMode": None, "modes": [],
                "mirrorOf": "",
            }
            orientation = re.search(r"\((normal|left|right|inverted)\b", line)
            if orientation:
                current["transform"] = orientation.group(1)
            outputs.append(current)
            continue
        if current is None:
            continue
        mode = MODE_RE.match(line)
        if not mode:
            continue
        width, height = int(mode.group(1)), int(mode.group(2))
        for rate in RATE_RE.finditer(mode.group(3)):
            flags = rate.group(2)
            entry = {
                "width": width, "height": height,
                "refreshRate": float(rate.group(1)),
                "preferred": "+" in flags, "current": "*" in flags,
            }
            current["modes"].append(entry)
            if entry["current"]:
                current["currentMode"] = entry
                current["width"], current["height"] = width, height
                current["refreshRate"] = entry["refreshRate"]
            if entry["preferred"] and current["preferredMode"] is None:
                current["preferredMode"] = entry
    return outputs


def validate(outputs):
    connected = {item["name"] for item in enumerate_outputs()}
    enabled = [item for item in outputs if item.get("enabled")]
    if not enabled:
        raise ValueError("At least one display must remain enabled")
    if any(item.get("name") not in connected for item in outputs):
        raise ValueError("Display connections changed; refresh and review the configuration")
    for item in enabled:
        modes = item.get("modes", [])
        selected = (int(item.get("width", 0)), int(item.get("height", 0)),
                    float(item.get("refreshRate", 0)))
        supported = any(
            (int(mode["width"]), int(mode["height"]), float(mode["refreshRate"])) == selected
            for mode in modes)
        if not supported:
            raise ValueError(f"Unsupported mode selected for {item['name']}")
        if not 0.5 <= float(item.get("scale", 1)) <= 3:
            raise ValueError(f"Invalid scale for {item['name']}")
        if item.get("transform", "normal") not in {"normal", "left", "right", "inverted"}:
            raise ValueError(f"Invalid orientation for {item['name']}")


def apply_outputs(outputs):
    args = []
    for item in outputs:
        args += ["--output", item["name"]]
        if not item.get("enabled"):
            args += ["--off"]
            continue
        args += ["--mode", f"{int(item['width'])}x{int(item['height'])}"]
        rate = float(item.get("refreshRate", 0))
        if rate > 0:
            args += ["--rate", f"{rate:.6g}"]
        args += ["--pos", f"{int(item.get('x', 0))}x{int(item.get('y', 0))}"]
        args += ["--rotate", item.get("transform", "normal")]
        scale = float(item.get("scale", 1))
        if abs(scale - 1.0) > 0.0001:
            args += ["--scale", f"{scale:.4g}x{scale:.4g}"]
        if item.get("primary"):
            args += ["--primary"]
        if item.get("mirrorOf"):
            args += ["--same-as", item["mirrorOf"]]
    result = xrandr(*args)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "xrandr apply failed")


def rollback_record():
    if not ROLLBACK_PATH.exists():
        return None
    return json.loads(ROLLBACK_PATH.read_text())


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "list"
    if command == "list":
        print(json.dumps({"backend": "xrandr", "supportsMirroring": True,
                          "supportsPrimary": True, "outputs": enumerate_outputs()}))
    elif command == "apply":
        outputs = json.loads(sys.argv[2])
        validate(outputs)
        token = uuid.uuid4().hex
        ROLLBACK_PATH.write_text(json.dumps({"token": token, "outputs": enumerate_outputs()}))
        try:
            apply_outputs(outputs)
        except Exception:
            ROLLBACK_PATH.unlink(missing_ok=True)
            raise
        subprocess.Popen([sys.executable, __file__, "watchdog", token],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print(json.dumps({"success": True, "token": token, "timeout": 15}))
    elif command == "keep":
        record = rollback_record()
        if record and record.get("token") == sys.argv[2]:
            ROLLBACK_PATH.unlink(missing_ok=True)
        print(json.dumps({"success": True}))
    elif command == "revert":
        record = rollback_record()
        if record and record.get("token") == sys.argv[2]:
            apply_outputs(record["outputs"])
            ROLLBACK_PATH.unlink(missing_ok=True)
        print(json.dumps({"success": True}))
    elif command == "watchdog":
        time.sleep(15)
        record = rollback_record()
        if record and record.get("token") == sys.argv[2]:
            apply_outputs(record["outputs"])
            ROLLBACK_PATH.unlink(missing_ok=True)
    else:
        raise ValueError(f"Unknown command: {command}")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(json.dumps({"success": False, "error": str(error)}))
        sys.exit(1)
