#!/usr/bin/env python3

"""Toggle the Picom autostart owned by the user's skarwm configuration."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


DEFAULT_COMMAND = (
    "picom --config "
    "${ANUSH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/skarwm/anush}"
    "/picom/picom.conf ${ANUSH_PICOM_ARGS:---no-use-damage} -b"
)
AUTOSTART = re.compile(
    r'^(?P<indent>\s*)(?P<comment>#\s*)?autostart\s*:\s*'
    r'"(?P<command>[^"]*\bpicom\b[^"]*)"\s*$'
)


def active_config(message: str) -> Path:
    if message:
        try:
            result = subprocess.run(
                [message, "get-version"], check=False, capture_output=True,
                text=True, timeout=3,
            )
            payload = json.loads(result.stdout)
            path = payload.get("loaded_config_file_name", "")
            if path:
                return Path(path)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            pass
    if os.environ.get("SKARWM_CONFIG"):
        return Path(os.environ["SKARWM_CONFIG"])
    config_home = Path(os.environ.get(
        "XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "skarwm/config.rc"


def find_picom(lines: list[str]):
    for index, line in enumerate(lines):
        match = AUTOSTART.match(line.rstrip("\n"))
        if match:
            return index, match
    return None, None


def atomic_write(path: Path, text: str) -> None:
    temporary = path.with_name(f".{path.name}.anush-{os.getpid()}")
    try:
        temporary.write_text(text)
        temporary.chmod(path.stat().st_mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def stop_picom() -> None:
    try:
        subprocess.run(
            ["pkill", "-x", "picom"], check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def start_picom(command: str) -> None:
    stop_picom()
    try:
        subprocess.Popen(
            ["sh", "-c", command], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        raise SystemExit(f"picom control: cannot start Picom: {error}")


def main() -> int:
    if len(sys.argv) not in (2, 3) or sys.argv[1] not in {
            "status", "enable", "disable"}:
        print("usage: picom-control status|enable|disable [SKARWM_MSG]",
              file=sys.stderr)
        return 2

    action = sys.argv[1]
    message = sys.argv[2] if len(sys.argv) == 3 else "skarwm-msg"
    path = active_config(message)
    if not path.is_file():
        print(f"picom control: skarwm config does not exist: {path}",
              file=sys.stderr)
        return 1

    lines = path.read_text().splitlines(keepends=True)
    index, match = find_picom(lines)
    enabled = match is not None and match.group("comment") is None
    command = match.group("command") if match is not None else DEFAULT_COMMAND
    available = shutil.which("picom") is not None

    if action == "enable":
        if not available:
            print("picom control: Picom is not installed", file=sys.stderr)
            return 1
        if match is None:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            lines.append(f'autostart : "{command}"\n')
        else:
            lines[index] = (
                f'{match.group("indent")}autostart : "{command}"\n')
        atomic_write(path, "".join(lines))
        start_picom(command)
        enabled = True
    elif action == "disable":
        if match is not None and enabled:
            lines[index] = (
                f'{match.group("indent")}# autostart : "{command}"\n')
            atomic_write(path, "".join(lines))
        stop_picom()
        enabled = False

    print(json.dumps({
        "available": available,
        "enabled": enabled,
        "config": str(path),
        "command": command,
    }, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
