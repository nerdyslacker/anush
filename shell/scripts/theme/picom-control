#!/usr/bin/env python3

"""Toggle the Picom autostart owned by the user's skarwm configuration."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


DEFAULT_COMMAND = (
    "picom --config "
    "${ANUSH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/skarwm/anush}"
    "/picom/picom.conf ${ANUSH_PICOM_ARGS:---no-use-damage} -b"
)
AUTOSTART = re.compile(
    r'^(?P<indent>\s*)(?P<comment>#\s*)?'
    r'(?P<key>[^=]+?)\s*=\s*(?P<command>.*\bpicom\b.*)\s*$'
)


def active_config(message: str) -> Path:
    if message:
        try:
            result = subprocess.run(
                [message, "get-version"], check=False, capture_output=True,
                text=True, timeout=3,
            )
            payload = json.loads(result.stdout)
            path = payload.get("loaded_config_file_name", "")
            if path:
                return Path(path)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            pass
    if os.environ.get("SKARWM_CONFIG"):
        return Path(os.environ["SKARWM_CONFIG"])
    config_home = Path(os.environ.get(
        "XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "skarwm/default.conf"


def find_picom(path: Path):
    if not path.is_file():
        return None, None
    lines = path.read_text().splitlines(keepends=True)
    section = ""
    active = None
    commented = None
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1].strip()
            continue
        if section != "autostart":
            continue
        match = AUTOSTART.match(line.rstrip("\n"))
        if match:
            candidate = (path, lines, index, match)
            if match.group("comment") is None:
                active = candidate
            else:
                commented = candidate
    return active, commented


def atomic_write(path: Path, text: str) -> None:
    temporary = path.with_name(f".{path.name}.anush-{os.getpid()}")
    try:
        temporary.write_text(text)
        temporary.chmod(path.stat().st_mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def stop_picom() -> None:
    try:
        subprocess.run(
            ["pkill", "-x", "picom"], check=False,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def start_picom(command: str) -> None:
    stop_picom()
    try:
        subprocess.Popen(
            ["sh", "-c", command], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        raise SystemExit(f"picom control: cannot start Picom: {error}")


def main() -> int:
    if len(sys.argv) not in (2, 3) or sys.argv[1] not in {
            "status", "enable", "disable"}:
        print("usage: picom-control status|enable|disable [SKARWM_MSG]",
              file=sys.stderr)
        return 2

    action = sys.argv[1]
    message = sys.argv[2] if len(sys.argv) == 3 else "skarwm-msg"
    root = active_config(message)
    if not root.is_file():
        print(f"picom control: skarwm config does not exist: {root}",
              file=sys.stderr)
        return 1

    config_set = Path(__file__).resolve().parent.parent / "skarwm/config-set"
    result = subprocess.run([sys.executable, str(config_set), "--path", str(root)], check=False,
                            capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        print(result.stderr.strip() or "picom control: cannot create anush.conf",
              file=sys.stderr)
        return 1
    path = Path(result.stdout.strip())

    active, commented = find_picom(path)
    candidate = active if active is not None else commented
    if candidate is None:
        source_path, lines, index, match = path, path.read_text().splitlines(keepends=True), None, None
    else:
        source_path, lines, index, match = candidate
    enabled = active is not None
    command = match.group("command").strip() if match is not None else DEFAULT_COMMAND
    if len(command) >= 2 and command[0] == command[-1] == '"':
        command = command[1:-1]
    available = shutil.which("picom") is not None

    if action == "enable":
        if not available:
            print("picom control: Picom is not installed", file=sys.stderr)
            return 1
        if match is None:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            if lines and lines[-1].strip():
                lines.append("\n")
            lines.extend(("[autostart]\n", f"picom = {command}\n"))
        else:
            lines[index] = (
                f'{match.group("indent")}{match.group("key").strip()} = {command}\n')
        atomic_write(source_path, "".join(lines))
        start_picom(command)
        enabled = True
    elif action == "disable":
        if match is not None and enabled:
            lines[index] = (
                f'{match.group("indent")}# {match.group("key").strip()} = {command}\n')
            atomic_write(source_path, "".join(lines))
        stop_picom()
        enabled = False

    print(json.dumps({
        "available": available,
        "enabled": enabled,
        "config": str(path),
        "command": command,
    }, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
