#!/usr/bin/env python3

"""Control the Picom instance owned by Anush."""

from __future__ import annotations

import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess
import sys
import time


def picom_config() -> Path:
    configured = os.environ.get("ANUSH_CONFIG_DIR", "")
    if configured:
        candidate = Path(configured) / "picom/picom.conf"
        if candidate.is_file():
            return candidate
    return Path(__file__).resolve().parents[3] / "config/picom/picom.conf"


def picom_command(config: Path) -> list[str]:
    # The bundled config enables damage tracking. Disabling it here overrides
    # the config and makes short ARGB popup fades arrive in coarse redraw
    # bursts on some X11 drivers. Keep extra arguments opt-in.
    arguments = shlex.split(os.environ.get("ANUSH_PICOM_ARGS", ""))
    return ["picom", "--config", str(config), *arguments, "-b"]


def stop_picom() -> None:
    for process in picom_pids():
        try:
            os.kill(process, signal.SIGTERM)
        except (OSError, ProcessLookupError):
            pass
    for _ in range(20):
        if not picom_running():
            return
        time.sleep(0.05)


def picom_pids() -> list[int]:
    wanted_display = os.environ.get("DISPLAY", "")
    processes = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if (entry / "comm").read_text().strip() != "picom":
                continue
            environment = (entry / "environ").read_bytes().split(b"\0")
            display = next((value.split(b"=", 1)[1].decode()
                            for value in environment
                            if value.startswith(b"DISPLAY=")), "")
            if wanted_display and display != wanted_display:
                continue
            processes.append(int(entry.name))
        except (OSError, UnicodeDecodeError, StopIteration, ValueError):
            continue
    return processes


def picom_running() -> bool:
    return bool(picom_pids())


def start_picom(command: list[str]) -> bool:
    stop_picom()
    try:
        subprocess.Popen(
            command, stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        raise SystemExit(f"picom control: cannot start Picom: {error}")
    for _ in range(20):
        if picom_running():
            return True
        time.sleep(0.05)
    return False


def main() -> int:
    if len(sys.argv) not in (2, 3) or sys.argv[1] not in {
            "status", "enable", "disable"}:
        print("usage: picom-control status|enable|disable [SKARWM_MSG]",
              file=sys.stderr)
        return 2

    action = sys.argv[1]
    config = picom_config()
    command = picom_command(config)
    available = shutil.which("picom") is not None
    enabled = picom_running()

    if action == "enable":
        if not available:
            print("picom control: Picom is not installed", file=sys.stderr)
            return 1
        if not start_picom(command):
            print("picom control: Picom exited during startup", file=sys.stderr)
            return 1
        enabled = True
    elif action == "disable":
        stop_picom()
        enabled = False
    print(json.dumps({
        "available": available,
        "enabled": enabled,
        "config": str(config),
        "command": shlex.join(command),
    }, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
