#!/usr/bin/env python3

"""Discover and apply XCursor themes across common desktop settings."""

from __future__ import annotations

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


def run(*command: str) -> None:
    try:
        subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except OSError:
        pass


def icon_roots() -> list[Path]:
    roots = [Path.home() / ".icons",
             Path(os.environ.get("XDG_DATA_HOME",
                                 Path.home() / ".local/share")) / "icons"]
    for directory in os.environ.get(
            "XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if directory:
            roots.append(Path(directory) / "icons")
    return list(dict.fromkeys(roots))


def cursor_themes() -> list[str]:
    themes: set[str] = set()
    for root in icon_roots():
        if not root.is_dir():
            continue
        try:
            children = list(root.iterdir())
        except OSError:
            continue
        for path in children:
            if path.is_dir() and (path / "index.theme").is_file() \
                    and (path / "cursors").is_dir():
                themes.add(path.name)
    return sorted(themes, key=str.casefold)


def current_theme() -> str:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME",
                                      Path.home() / ".config"))
    for relative in ("gtk-4.0/settings.ini", "gtk-3.0/settings.ini"):
        try:
            text = (config_home / relative).read_text(errors="replace")
        except OSError:
            continue
        match = re.search(r"(?mi)^gtk-cursor-theme-name\s*=\s*(.+)$", text)
        if match:
            return match.group(1).strip().strip("'\"")
    if shutil.which("gsettings"):
        try:
            return subprocess.check_output([
                "gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"
            ], stderr=subprocess.DEVNULL, text=True).strip().strip("'\"")
        except (OSError, subprocess.SubprocessError):
            pass
    return ""


def atomic_write(text: str, destination: Path) -> None:
    temporary = destination.with_name(destination.name + ".tmp")
    temporary.write_text(text)
    os.replace(temporary, destination)


def set_ini_value(path: Path, section: str, key: str, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.exists() else ""
    heading = f"[{section}]"
    pattern = re.compile(rf"(?m)^{re.escape(key)}\s*=.*$")
    if heading not in text:
        text += ("\n" if text and not text.endswith("\n") else "")
        text += f"{heading}\n{key}={value}\n"
    else:
        start = text.index(heading) + len(heading)
        end = text.find("\n[", start)
        end = len(text) if end < 0 else end
        body = text[start:end]
        body = pattern.sub(f"{key}={value}", body) \
            if pattern.search(body) else body + f"\n{key}={value}"
        text = text[:start] + body + text[end:]
    atomic_write(text, path)


def set_xsettings(path: Path, key: str, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.exists() else ""
    pattern = re.compile(rf"(?m)^{re.escape(key)}\s+.*$")
    line = f'{key} "{value}"'
    text = pattern.sub(line, text) if pattern.search(text) \
        else text + "\n" + line + "\n"
    atomic_write(text.lstrip("\n"), path)


def set_xresource(path: Path, key: str, value: str) -> None:
    text = path.read_text() if path.exists() else ""
    pattern = re.compile(rf"(?mi)^{re.escape(key)}\s*:.*$")
    line = f"{key}: {value}"
    text = pattern.sub(line, text) if pattern.search(text) \
        else text + ("\n" if text and not text.endswith("\n") else "") + line + "\n"
    atomic_write(text, path)


def apply_theme(theme: str) -> int:
    if theme not in cursor_themes():
        return 1
    config_home = Path(os.environ.get("XDG_CONFIG_HOME",
                                      Path.home() / ".config"))
    for gtk in ("gtk-3.0", "gtk-4.0"):
        set_ini_value(config_home / gtk / "settings.ini", "Settings",
                      "gtk-cursor-theme-name", theme)
    set_xsettings(config_home / "xsettingsd" / "xsettingsd.conf",
                  "Gtk/CursorThemeName", theme)
    resources = Path.home() / ".Xresources"
    set_xresource(resources, "Xcursor.theme", theme)
    kde = ["--file", "kcminputrc", "--group", "Mouse",
           "--key", "cursorTheme", theme]
    if shutil.which("kwriteconfig6"):
        run("kwriteconfig6", *kde)
    elif shutil.which("kwriteconfig5"):
        run("kwriteconfig5", *kde)
    if shutil.which("gsettings"):
        run("gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", theme)
    if shutil.which("xfconf-query"):
        run("xfconf-query", "-c", "xsettings", "-p", "/Gtk/CursorThemeName",
            "-n", "-t", "string", "-s", theme)
    if shutil.which("xrdb"):
        run("xrdb", "-merge", str(resources))
    run("pkill", "-HUP", "-x", "xsettingsd")
    if shutil.which("xsetroot"):
        run("xsetroot", "-cursor_name", "left_ptr")
    return 0


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--list":
        print("\n".join(cursor_themes()))
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "--current":
        print(current_theme())
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "--set":
        return apply_theme(sys.argv[2])
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
