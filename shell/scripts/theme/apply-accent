#!/bin/sh

# Keep external application highlights in sync with Quickshell's accent.
set -u

accent=${1:-}
wm_message=${2:-}
foreground=${3:-$accent}
secondary=${4:-$accent}
decoration_active_background=${5:-$accent}
decoration_inactive_background=${6:-$foreground}
decoration_active_foreground=${7:-$foreground}
decoration_inactive_foreground=${8:-$foreground}
decoration_active_border=${9:-$accent}
decoration_inactive_border=${10:-$secondary}
background=${12:-}
surface=${13:-}
disabled=${14:-}
outline=${15:-}
red=${16:-}
green=${17:-}
yellow=${18:-}
blue=${19:-}
magenta=${20:-}
cyan=${21:-}
white=${22:-}
bright_black=${23:-}
bright_red=${24:-}
bright_green=${25:-}
bright_yellow=${26:-}
bright_blue=${27:-}
bright_magenta=${28:-}
bright_cyan=${29:-}
bright_white=${30:-}
case $accent in
    \#*) ;;
    *) exit 2 ;;
esac

valid_color() {
    color=$1
    case $color in
        \#??????) ;;
        *) return 1 ;;
    esac
    case ${color#\#} in
        *[!0-9A-Fa-f]*) return 1 ;;
    esac
}

valid_color "$accent" || exit 2
valid_color "$foreground" || exit 2
valid_color "$secondary" || exit 2
valid_color "$decoration_active_background" || exit 2
valid_color "$decoration_inactive_background" || exit 2
valid_color "$decoration_active_foreground" || exit 2
valid_color "$decoration_inactive_foreground" || exit 2
valid_color "$decoration_active_border" || exit 2
valid_color "$decoration_inactive_border" || exit 2
if [ "$#" -ge 30 ]; then
    for color in "$background" "$surface" "$disabled" "$outline" \
            "$red" "$green" "$yellow" "$blue" "$magenta" "$cyan" \
            "$white" "$bright_black" "$bright_red" "$bright_green" \
            "$bright_yellow" "$bright_blue" "$bright_magenta" \
            "$bright_cyan" "$bright_white"; do
        valid_color "$color" || exit 2
    done
fi

if valid_color "$background" && valid_color "$surface" \
        && valid_color "$disabled" && valid_color "$outline"; then
    "$(dirname "$0")/apply-openbox-theme" \
        "$background" "$surface" "$decoration_active_background" \
        "$decoration_inactive_background" "$foreground" "$disabled" \
        "$accent" "$outline"
fi

hex_to_sgr() {
    color=${1#\#}
    red=$(printf '%d' "0x${color%????}")
    rest=${color#??}
    green=$(printf '%d' "0x${rest%??}")
    blue=$(printf '%d' "0x${rest#??}")
    printf '38;2;%s;%s;%s' "$red" "$green" "$blue"
}

accent_sgr=$(hex_to_sgr "$accent")
foreground_sgr=$(hex_to_sgr "$foreground")
secondary_sgr=$(hex_to_sgr "$secondary")

config_dir=${ANUSH_CONFIG_DIR:-$(CDPATH= cd "$(dirname "$0")/../../../config" && pwd)}
message=$(command -v "$wm_message" 2>/dev/null || true)
if [ -z "$message" ]; then
    message=$(command -v skarwm-msg 2>/dev/null || true)
fi
active_config=
if [ -n "$message" ]; then
    active_config=$(
        "$message" get-version 2>/dev/null \
            | sed -n 's/.*"loaded_config_file_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
    )
fi

rewrite() {
    file=$1
    expression=$2
    [ -f "$file" ] && [ -w "$file" ] || return 0

    temporary=$(mktemp "${file}.accent.XXXXXX") || return 1
    if sed -E "$expression" "$file" > "$temporary"; then
        chmod 644 "$temporary"
        mv "$temporary" "$file"
    else
        rm -f "$temporary"
        return 1
    fi
}

rewrite_key() {
    file=$1
    key=$2
    value=$3
    [ -f "$file" ] && [ -w "$file" ] || return 0

    temporary=$(mktemp "${file}.accent.XXXXXX") || return 1
    if grep -Eq "^[[:space:]]*${key}[[:space:]]*:" "$file"; then
        sed -E "s|^[[:space:]]*${key}[[:space:]]*:.*$|${key} : ${value}|" \
            "$file" > "$temporary" || { rm -f "$temporary"; return 1; }
    else
        sed '$a\
'"${key} : ${value}" "$file" > "$temporary" \
            || { rm -f "$temporary"; return 1; }
    fi
    chmod 644 "$temporary"
    mv "$temporary" "$file"
}

rewrite_decoration_palette() {
    file=$1
    # Decoration enablement belongs to the rc/UI sync, not palette updates.
    rewrite_key "$file" decoration_color_source explicit
    rewrite_key "$file" decoration_accent "$accent"
    rewrite_key "$file" decoration_active_background "$decoration_active_background"
    rewrite_key "$file" decoration_inactive_background "$decoration_inactive_background"
    rewrite_key "$file" decoration_active_foreground "$decoration_active_foreground"
    rewrite_key "$file" decoration_inactive_foreground "$decoration_inactive_foreground"
    rewrite_key "$file" decoration_active_border "$decoration_active_border"
    rewrite_key "$file" decoration_inactive_border "$decoration_inactive_border"
}

rewrite "$config_dir/rofi/colors.rasi" \
    "/^[[:space:]]*(accent|border|prompt-fg):/ s/#[0-9A-Fa-f]{6}/$accent/"

rewrite "$config_dir/kitty/current-theme.conf" \
    "/^[[:space:]]*(selection_background|url_color|active_border_color|active_tab_background|mark1_background|color4|color12)[[:space:]]+/ s/#[0-9A-Fa-f]{6}/$accent/"

if [ "$#" -ge 30 ]; then
    nare_theme="$config_dir/nare/themes/anush.conf"
    if [ -f "$nare_theme" ] && [ -w "$nare_theme" ]; then
        temporary=$(mktemp "${nare_theme}.accent.XXXXXX") || exit 1
        cat > "$temporary" <<EOF
# Generated by anush. Changes are replaced when the theme changes.

[colors]
foreground=$foreground
background=$background
selection-foreground=$background
selection-background=$accent
cursor=$foreground
cursor-text=$background
url=$accent
active-border=$accent
inactive-border=$disabled
bell-border=$red
active-tab-foreground=$background
active-tab-background=$accent
inactive-tab-foreground=$foreground
inactive-tab-background=$surface
root-tab-background=$red
tab-bar-background=$background
color0=$surface
color1=$red
color2=$green
color3=$yellow
color4=$blue
color5=$magenta
color6=$cyan
color7=$white
color8=$bright_black
color9=$bright_red
color10=$bright_green
color11=$bright_yellow
color12=$bright_blue
color13=$bright_magenta
color14=$bright_cyan
color15=$bright_white

[tmux]
active-tab-color=$green

[statusbar]
background=$background
foreground=$foreground
accent=$accent

[statusbar.mode]
background=$accent
foreground=$background

[statusbar.session]
background=$bright_blue
foreground=$background

[statusbar.host]
background=$surface
foreground=$foreground

[statusbar.cwd]
background=$background
foreground=$foreground

[statusbar.git]
background=$surface
foreground=$foreground

[statusbar.command]
background=$outline
foreground=$foreground

[statusbar.size]
background=$outline
foreground=$foreground

[statusbar.tabs]
background=$surface
foreground=$foreground

[statusbar.clock]
background=$accent
foreground=$background

[statusbar.battery]
background=$surface
foreground=$foreground

[statusbar.resource]
background=$background
foreground=$foreground

[statusbar.zoom]
background=$surface
foreground=$foreground

[statusbar.jobs]
background=$surface
foreground=$foreground
success-background=$green
failure-background=$red
EOF
        chmod 644 "$temporary"
        mv "$temporary" "$nare_theme"
    fi
fi

rewrite "$config_dir/dunst/dunstrc" \
    "/THEME: dunst_(frame_(global|low|normal)|highlight_normal)/ s/#[0-9A-Fa-f]{6}/$accent/"

rewrite "$config_dir/fastfetch/config.jsonc" \
    "/THEME: fastfetch_primary/ s|38;2;[0-9]+;[0-9]+;[0-9]+|$accent_sgr|; /THEME: fastfetch_foreground/ s|38;2;[0-9]+;[0-9]+;[0-9]+|$foreground_sgr|; /THEME: fastfetch_secondary/ s|38;2;[0-9]+;[0-9]+;[0-9]+|$secondary_sgr|"

# Keep the configuration used at the next skarwm startup in sync with the
# live palette. Otherwise a missing IPC client (or a restart) restores the old
# focus border even though every application already uses the new accent.
if [ -n "$active_config" ]; then
    wm_config=$active_config
elif [ -n "${SKARWM_CONFIG:-}" ]; then
    wm_config=$SKARWM_CONFIG
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    if [ -f "$XDG_CONFIG_HOME/skarwm/skarwm.rc" ]; then
        wm_config=$XDG_CONFIG_HOME/skarwm/skarwm.rc
    else
        wm_config=$XDG_CONFIG_HOME/skarwm/config.rc
    fi
elif [ -n "${HOME:-}" ]; then
    if [ -f "$HOME/.config/skarwm/skarwm.rc" ]; then
        wm_config=$HOME/.config/skarwm/skarwm.rc
    else
        wm_config=$HOME/.config/skarwm/config.rc
    fi
else
    wm_config=
fi
if [ -n "$wm_config" ]; then
    rewrite "$wm_config" \
        "/^[[:space:]]*sel_outer_border[[:space:]]*:/ s/#[0-9A-Fa-f]{6}/$accent/"
    rewrite_decoration_palette "$wm_config"
fi

[ -z "$message" ] || "$message" theme-colors \
    "$accent" "$decoration_active_background" \
    "$decoration_inactive_background" "$decoration_active_foreground" \
    "$decoration_inactive_foreground" "$decoration_active_border" \
    "$decoration_inactive_border" "$secondary" >/dev/null 2>&1 || true

# Rofi reads its theme for every invocation. Reload existing Kitty and Dunst
# processes when their control mechanisms are available.
if [ "${ANUSH_ACCENT_NO_RELOAD:-0}" != 1 ]; then
    if command -v pkill >/dev/null 2>&1; then
        pkill -USR1 -x kitty 2>/dev/null || true
    fi
    if command -v dunstctl >/dev/null 2>&1; then
        dunstctl reload >/dev/null 2>&1 || true
    elif command -v pkill >/dev/null 2>&1; then
        pkill -HUP -x dunst 2>/dev/null || true
    fi
fi
