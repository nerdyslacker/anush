#!/bin/sh

# Apply anush's decoration switch without reloading skarwm.
set -u

enabled=${1:-}
wm_message=${2:-}
case $enabled in
    true|false) ;;
    *) exit 2 ;;
esac

message=$(command -v "$wm_message" 2>/dev/null || true)
[ -z "$message" ] || "$message" decorations "$enabled" >/dev/null 2>&1 || true
