#!/bin/sh

# Persist anush's decoration switch in the user's live skarwm configuration,
# then make the change visible immediately.
set -u

enabled=${1:-}
wm_message=${2:-}
case $enabled in
    true|false) ;;
    *) exit 2 ;;
esac

message=$(command -v "$wm_message" 2>/dev/null || true)
if [ -z "$message" ]; then
    message=$(command -v skarwm-msg 2>/dev/null || true)
fi
active_config=
if [ -n "$message" ]; then
    active_config=$(
        "$message" get-version 2>/dev/null \
            | sed -n 's/.*"loaded_config_file_name":"\([^"]*\)".*/\1/p'
    )
fi

if [ -n "$active_config" ]; then
    live_config=$active_config
elif [ -n "${SKARWM_CONFIG:-}" ]; then
    live_config=$SKARWM_CONFIG
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    live_config=$XDG_CONFIG_HOME/skarwm/default.conf
elif [ -n "${HOME:-}" ]; then
    live_config=$HOME/.config/skarwm/default.conf
else
    live_config=
fi
if [ -n "$live_config" ]; then
    config_set=$(CDPATH= cd "$(dirname "$0")/../skarwm" && pwd)/config-set
    "$config_set" "$live_config" window.decoration enabled "$enabled"
fi

if [ "${ANUSH_DECORATION_NO_RELOAD:-0}" != 1 ]; then
    if [ -n "$message" ]; then
        # Apply directly to the running WM. A reload can read an explicit -c
        # path that this helper cannot discover, leaving the switch unchanged.
        if ! "$message" decorations "$enabled" >/dev/null 2>&1; then
            # Fall back to reloading when direct runtime control is unavailable.
            "$message" reload >/dev/null 2>&1 || true
        fi
    fi
fi
