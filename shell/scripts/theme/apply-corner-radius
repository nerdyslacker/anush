#!/bin/sh

# Keep skarwm's native window corners in sync without reloading its config.
set -u

radius=${1:-}
wm_message=${2:-}
case $radius in
    ''|*[!0-9]*) exit 2 ;;
esac
[ "$radius" -le 4096 ] || exit 2

message=$(command -v "$wm_message" 2>/dev/null || true)
[ -z "$message" ] || "$message" corner-radius "$radius" >/dev/null 2>&1 || true
