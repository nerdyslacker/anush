#!/usr/bin/env python3

"""Discover and apply icon themes without replacing the selected theme."""

from __future__ import annotations

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

# Older Anush versions selected this generated overlay during every accent
# change. Keep the name only so existing installations can migrate away from
# it; no new overlay is created or selected.
LEGACY_OVERLAY_NAME = "Anush-Papirus"

PAPIRUS_FOLDER_COLOURS = {
    "black": "#4f4f4f", "blue": "#5294e2", "bluegrey": "#607d8b",
    "breeze": "#57bee8", "brown": "#8e6e53", "carmine": "#a30002",
    "cyan": "#00bcd4", "darkcyan": "#009688", "deeporange": "#ff7043",
    "green": "#4caf50", "grey": "#9e9e9e", "indigo": "#5c6bc0",
    "magenta": "#e91e63", "nordic": "#81a1c1", "orange": "#ff9800",
    "palebrown": "#bcaaa4", "paleorange": "#ffcc80", "pink": "#ec407a",
    "red": "#f44336", "teal": "#009688", "violet": "#9c27b0",
    "white": "#f5f5f5", "yaru": "#e95420", "yellow": "#ffc107",
}


def run(*command: str) -> None:
    try:
        subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except OSError:
        pass


def icon_roots() -> list[Path]:
    roots = [Path.home() / ".icons",
             Path(os.environ.get("XDG_DATA_HOME",
                                 Path.home() / ".local/share")) / "icons"]
    for directory in os.environ.get(
            "XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if directory:
            roots.append(Path(directory) / "icons")
    return list(dict.fromkeys(roots))


def theme_path(name: str) -> Path | None:
    for root in icon_roots():
        candidate = root / name
        if (candidate / "index.theme").is_file():
            return candidate
    return None


def index_value(path: Path, key: str) -> str:
    try:
        text = (path / "index.theme").read_text(errors="replace")
    except OSError:
        return ""
    match = re.search(rf"(?mi)^{re.escape(key)}\s*=\s*(.+)$", text)
    return match.group(1).strip() if match else ""


def icon_themes() -> list[str]:
    themes: set[str] = set()
    for root in icon_roots():
        if not root.is_dir():
            continue
        try:
            children = list(root.iterdir())
        except OSError:
            continue
        for path in children:
            if not path.is_dir() or path.name == LEGACY_OVERLAY_NAME \
                    or not (path / "index.theme").is_file():
                continue
            directories = index_value(path, "Directories").split(",")
            if any(item.strip() and "cursor" not in item.lower()
                   for item in directories):
                themes.add(path.name)
    return sorted(themes, key=str.casefold)


def configured_theme() -> str:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME",
                                      Path.home() / ".config"))
    for relative in ("gtk-4.0/settings.ini", "gtk-3.0/settings.ini"):
        path = config_home / relative
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        match = re.search(r"(?mi)^gtk-icon-theme-name\s*=\s*(.+)$", text)
        if match:
            value = match.group(1).strip().strip("'\"")
            return value
    if shutil.which("gsettings"):
        try:
            return subprocess.check_output([
                "gsettings", "get", "org.gnome.desktop.interface", "icon-theme"
            ], stderr=subprocess.DEVNULL, text=True).strip().strip("'\"")
        except (OSError, subprocess.SubprocessError):
            pass
    return ""


def current_theme() -> str:
    selected = configured_theme()
    if selected != LEGACY_OVERLAY_NAME:
        return selected
    overlay = theme_path(LEGACY_OVERLAY_NAME)
    inherited = index_value(overlay, "Inherits") if overlay else ""
    return inherited.split(",")[0].strip()


def atomic_write(text: str, destination: Path) -> None:
    temporary = destination.with_name(destination.name + ".tmp")
    temporary.write_text(text)
    os.replace(temporary, destination)


def nearest_papirus_colour(accent: str) -> str:
    match = re.fullmatch(r"#?(?:[0-9a-fA-F]{2})?([0-9a-fA-F]{6})", accent)
    if not match:
        return "blue"
    value = match.group(1)
    target = tuple(int(value[index:index + 2], 16) for index in (0, 2, 4))
    return min(PAPIRUS_FOLDER_COLOURS, key=lambda name: sum(
        (target[channel] - int(PAPIRUS_FOLDER_COLOURS[name][
            1 + channel * 2:3 + channel * 2], 16)) ** 2
        for channel in range(3)))


def available_papirus_colours(path: Path) -> set[str]:
    places = path / "48x48/places"
    colours = set()
    for icon in places.glob("folder-*-documents.svg"):
        match = re.fullmatch(r"folder-(.+)-documents\.svg", icon.name)
        if match and not icon.is_symlink():
            colours.add(match.group(1))
    return colours


def nearest_papirus_colour_for_theme(path: Path, accent: str) -> str | None:
    available = available_papirus_colours(path)
    known = {name: value for name, value in PAPIRUS_FOLDER_COLOURS.items()
             if name in available}
    if not known:
        return None
    match = re.fullmatch(r"#?(?:[0-9a-fA-F]{2})?([0-9a-fA-F]{6})", accent)
    if not match:
        return "blue" if "blue" in known else next(iter(sorted(known)))
    value = match.group(1)
    target = tuple(int(value[index:index + 2], 16) for index in (0, 2, 4))
    return min(known, key=lambda name: sum(
        (target[channel] - int(known[name][
            1 + channel * 2:3 + channel * 2], 16)) ** 2
        for channel in range(3)))


def recolour_papirus_without_helper(path: Path, colour: str) -> bool:
    """Apply Papirus's own symlink algorithm to a writable user theme."""
    changed = False
    for size in ("22x22", "24x24", "32x32", "48x48", "64x64"):
        places = path / size / "places"
        if not places.is_dir() or not os.access(places.resolve(), os.W_OK):
            continue
        for prefix in (f"folder-{colour}", f"user-{colour}"):
            sources = list(places.glob(prefix + "-*.svg"))
            direct = places / (prefix + ".svg")
            if direct.is_file():
                sources.append(direct)
            for source in sources:
                if source.is_symlink() or not source.is_file():
                    continue
                destination = source.with_name(
                    source.name.replace(f"-{colour}", "", 1))
                if destination == source:
                    continue
                temporary = destination.with_name(
                    f".{destination.name}.anush-{os.getpid()}")
                try:
                    temporary.unlink(missing_ok=True)
                    temporary.symlink_to(source.name)
                    os.replace(temporary, destination)
                    changed = True
                except OSError:
                    temporary.unlink(missing_ok=True)
    if changed and shutil.which("gtk-update-icon-cache"):
        siblings = [path]
        try:
            siblings.extend(candidate for candidate in path.parent.iterdir()
                            if candidate != path
                            and candidate.name.casefold().startswith("papirus")
                            and (candidate / "index.theme").is_file())
        except OSError:
            pass
        for theme_path in siblings:
            run("gtk-update-icon-cache", "-f", "-t", str(theme_path))
    if changed and shutil.which("dbus-send"):
        run("dbus-send", "--session", "--type=signal", "/KGlobalSettings",
            "org.kde.KGlobalSettings.notifyChange", "int32:4", "int32:0")
    if changed:
        run("pkill", "-HUP", "-x", "xsettingsd")
    return changed


def recolour_folders(theme: str, accent: str) -> None:
    # Folder recolouring is an explicit capability of Papirus itself. A theme
    # merely inheriting Papirus is not treated as Papirus: doing so previously
    # replaced unrelated themes with Anush-Papirus on every accent change.
    if not theme.casefold().startswith("papirus"):
        return
    helper = shutil.which("papirus-folders")
    if helper:
        run(helper, "-C", nearest_papirus_colour(accent), "--theme", theme)
        return
    path = theme_path(theme)
    if not path:
        return
    colour = nearest_papirus_colour_for_theme(path, accent)
    if not colour:
        return
    recolour_papirus_without_helper(path, colour)


def set_ini_value(path: Path, section: str, key: str, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.exists() else ""
    heading = f"[{section}]"
    key_pattern = re.compile(rf"(?m)^{re.escape(key)}\s*=.*$")
    if heading not in text:
        text += ("\n" if text and not text.endswith("\n") else "")
        text += f"{heading}\n{key}={value}\n"
    else:
        start = text.index(heading) + len(heading)
        end = text.find("\n[", start)
        end = len(text) if end < 0 else end
        body = text[start:end]
        body = key_pattern.sub(f"{key}={value}", body) \
            if key_pattern.search(body) else body + f"\n{key}={value}"
        text = text[:start] + body + text[end:]
    atomic_write(text, path)


def set_xsettings(path: Path, key: str, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.exists() else ""
    pattern = re.compile(rf"(?m)^{re.escape(key)}\s+.*$")
    line = f'{key} "{value}"'
    text = pattern.sub(line, text) if pattern.search(text) \
        else text + "\n" + line + "\n"
    atomic_write(text.lstrip("\n"), path)


def configure_desktops(theme: str, cache: Path | None = None) -> None:
    config_home = Path(os.environ.get(
        "XDG_CONFIG_HOME", Path.home() / ".config"))
    for gtk in ("gtk-3.0", "gtk-4.0"):
        set_ini_value(config_home / gtk / "settings.ini", "Settings",
                      "gtk-icon-theme-name", theme)
    set_xsettings(config_home / "xsettingsd" / "xsettingsd.conf",
                  "Net/IconThemeName", theme)
    kde = ["--file", "kdeglobals", "--group", "Icons", "--key", "Theme", theme]
    if shutil.which("kwriteconfig6"):
        run("kwriteconfig6", *kde)
    elif shutil.which("kwriteconfig5"):
        run("kwriteconfig5", *kde)
    if shutil.which("gsettings"):
        run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", theme)
    if shutil.which("xfconf-query"):
        run("xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName",
            "-n", "-t", "string", "-s", theme)
    if cache and shutil.which("gtk-update-icon-cache"):
        run("gtk-update-icon-cache", "-f", "-t", str(cache))
    if shutil.which("dbus-send"):
        run("dbus-send", "--session", "--type=signal", "/KGlobalSettings",
            "org.kde.KGlobalSettings.notifyChange", "int32:4", "int32:0")
    run("pkill", "-HUP", "-x", "xsettingsd")


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--list":
        print("\n".join(icon_themes()))
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "--current":
        print(current_theme())
        return 0
    if len(sys.argv) >= 3 and sys.argv[1] == "--set":
        selected = sys.argv[2]
        if not theme_path(selected):
            return 1
        configure_desktops(selected)
        if len(sys.argv) >= 4:
            recolour_folders(selected, sys.argv[3])
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == "--accent":
        selected = sys.argv[2]
        # Repair settings written by older Anush versions, but otherwise an
        # accent change must never change the configured icon theme.
        if configured_theme() == LEGACY_OVERLAY_NAME and theme_path(selected):
            configure_desktops(selected)
        recolour_folders(selected, sys.argv[3])
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
