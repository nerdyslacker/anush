#!/usr/bin/env python3

"""Discover and apply icon themes without replacing the selected theme."""

from __future__ import annotations

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

# Older Anush versions selected this generated overlay during every accent
# change. Keep the name only so existing installations can migrate away from
# it; no new overlay is created or selected.
LEGACY_OVERLAY_NAME = "Anush-Papirus"
MANAGED_OVERLAY_PREFIX = "Anush-"
MANAGED_OVERLAY_SUFFIX = "-Folders"

def run(*command: str) -> None:
    try:
        subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except OSError:
        pass


def icon_roots() -> list[Path]:
    roots = [Path.home() / ".icons",
             Path(os.environ.get("XDG_DATA_HOME",
                                 Path.home() / ".local/share")) / "icons"]
    for directory in os.environ.get(
            "XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
        if directory:
            roots.append(Path(directory) / "icons")
    return list(dict.fromkeys(roots))


def theme_path(name: str) -> Path | None:
    for root in icon_roots():
        candidate = root / name
        if (candidate / "index.theme").is_file():
            return candidate
    return None


def index_value(path: Path, key: str) -> str:
    try:
        text = (path / "index.theme").read_text(errors="replace")
    except OSError:
        return ""
    match = re.search(rf"(?mi)^{re.escape(key)}\s*=\s*(.+)$", text)
    return match.group(1).strip() if match else ""


def icon_themes() -> list[str]:
    themes: set[str] = set()
    for root in icon_roots():
        if not root.is_dir():
            continue
        try:
            children = list(root.iterdir())
        except OSError:
            continue
        for path in children:
            if not path.is_dir() or is_managed_overlay(path.name) \
                    or not (path / "index.theme").is_file():
                continue
            directories = index_value(path, "Directories").split(",")
            if any(item.strip() and "cursor" not in item.lower()
                   for item in directories):
                themes.add(path.name)
    return sorted(themes, key=str.casefold)


def configured_theme() -> str:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME",
                                      Path.home() / ".config"))
    for relative in ("gtk-4.0/settings.ini", "gtk-3.0/settings.ini"):
        path = config_home / relative
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        match = re.search(r"(?mi)^gtk-icon-theme-name\s*=\s*(.+)$", text)
        if match:
            value = match.group(1).strip().strip("'\"")
            return value
    if shutil.which("gsettings"):
        try:
            return subprocess.check_output([
                "gsettings", "get", "org.gnome.desktop.interface", "icon-theme"
            ], stderr=subprocess.DEVNULL, text=True).strip().strip("'\"")
        except (OSError, subprocess.SubprocessError):
            pass
    return ""


def current_theme() -> str:
    selected = configured_theme()
    if not is_managed_overlay(selected):
        return selected
    overlay = theme_path(selected)
    inherited = index_value(overlay, "Inherits") if overlay else ""
    return inherited.split(",")[0].strip()


def is_managed_overlay(name: str) -> bool:
    return name == LEGACY_OVERLAY_NAME or (
        name.startswith(MANAGED_OVERLAY_PREFIX)
        and name.endswith(MANAGED_OVERLAY_SUFFIX))


def atomic_write(text: str, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(
        f".{destination.name}.anush-{os.getpid()}")
    try:
        temporary.write_text(text)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def normalize_accent(accent: str) -> str | None:
    match = re.fullmatch(r"#?(?:[0-9a-fA-F]{2})?([0-9a-fA-F]{6})", accent)
    if not match:
        return None
    return "#" + match.group(1).lower()


def dark_accent(accent: str) -> str:
    return "#" + "".join(
        f"{round(int(accent[index:index + 2], 16) * 0.82):02x}"
        for index in (1, 3, 5))


def recolour_svg(text: str, accent: str) -> str:
    text = re.sub(r"#5294e2", accent, text, flags=re.IGNORECASE)
    return re.sub(r"#4877b1", dark_accent(accent), text,
                  flags=re.IGNORECASE)


def overlay_name(theme: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "-", theme).strip("-.")
    return f"{MANAGED_OVERLAY_PREFIX}{safe or 'Papirus'}{MANAGED_OVERLAY_SUFFIX}"


def create_papirus_overlay(path: Path, theme: str, accent: str) -> str | None:
    """Generate Papirus folder SVGs using the exact active accent."""
    name = overlay_name(theme)
    data_home = Path(os.environ.get(
        "XDG_DATA_HOME", Path.home() / ".local/share"))
    destination = data_home / "icons" / name
    directories = []

    for size in ("16x16", "22x22", "24x24", "32x32", "48x48", "64x64"):
        source_places = path / size / "places"
        if not source_places.is_dir():
            continue
        target_places = destination / size / "places"
        linked = False
        for prefix in ("folder-blue", "user-blue"):
            sources = list(source_places.glob(prefix + "-*.svg"))
            direct = source_places / (prefix + ".svg")
            if direct.is_file():
                sources.append(direct)
            for source in sources:
                if source.is_symlink() or not source.is_file():
                    continue
                target_places.mkdir(parents=True, exist_ok=True)
                generic = source.name.replace("-blue", "", 1)
                target = target_places / generic
                try:
                    generated = recolour_svg(
                        source.read_text(errors="replace"), accent)
                    atomic_write(generated, target)
                    linked = True
                except OSError:
                    pass
        if linked:
            # File managers commonly request the MIME icon name for newly
            # created directories. Papirus normally inherits this symlink
            # from its base theme, which bypasses our generated folder.svg.
            folder = target_places / "folder.svg"
            if folder.is_file():
                try:
                    atomic_write(folder.read_text(errors="replace"),
                                 target_places / "inode-directory.svg")
                except OSError:
                    pass
            directories.append(f"{size}/places")

    if not directories:
        return None

    sections = []
    for directory in directories:
        size = directory.split("x", 1)[0]
        sections.append(f"""[{directory}]
Size={size}
Context=Places
Type=Fixed
""")
    sections_text = "\n".join(sections)
    index = f"""[Icon Theme]
Name=Anush {theme} folder colours
Comment=Accent-coloured folders managed by Anush
Inherits={theme}
Directories={','.join(directories)}

{sections_text}"""
    destination.mkdir(parents=True, exist_ok=True)
    atomic_write(index, destination / "index.theme")
    return name


def recolour_folders(theme: str, accent: str) -> str:
    # Folder recolouring is an explicit capability of Papirus itself. A theme
    # merely inheriting Papirus is not treated as Papirus: doing so previously
    # replaced unrelated themes with Anush-Papirus on every accent change.
    if not theme.casefold().startswith("papirus"):
        return theme
    path = theme_path(theme)
    if not path:
        return theme
    normalized = normalize_accent(accent)
    if not normalized:
        return theme
    return create_papirus_overlay(path, theme, normalized) or theme


def set_ini_value(path: Path, section: str, key: str, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.exists() else ""
    heading = f"[{section}]"
    key_pattern = re.compile(rf"(?m)^{re.escape(key)}\s*=.*$")
    if heading not in text:
        text += ("\n" if text and not text.endswith("\n") else "")
        text += f"{heading}\n{key}={value}\n"
    else:
        start = text.index(heading) + len(heading)
        end = text.find("\n[", start)
        end = len(text) if end < 0 else end
        body = text[start:end]
        body = key_pattern.sub(f"{key}={value}", body) \
            if key_pattern.search(body) else body + f"\n{key}={value}"
        text = text[:start] + body + text[end:]
    atomic_write(text, path)


def set_xsettings(path: Path, key: str, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text() if path.exists() else ""
    pattern = re.compile(rf"(?m)^{re.escape(key)}\s+.*$")
    line = f'{key} "{value}"'
    text = pattern.sub(line, text) if pattern.search(text) \
        else text + "\n" + line + "\n"
    atomic_write(text.lstrip("\n"), path)


def configure_desktops(theme: str, cache: Path | None = None) -> None:
    config_home = Path(os.environ.get(
        "XDG_CONFIG_HOME", Path.home() / ".config"))
    for gtk in ("gtk-3.0", "gtk-4.0"):
        set_ini_value(config_home / gtk / "settings.ini", "Settings",
                      "gtk-icon-theme-name", theme)
    set_xsettings(config_home / "xsettingsd" / "xsettingsd.conf",
                  "Net/IconThemeName", theme)
    kde = ["--file", "kdeglobals", "--group", "Icons", "--key", "Theme", theme]
    if shutil.which("kwriteconfig6"):
        run("kwriteconfig6", *kde)
    elif shutil.which("kwriteconfig5"):
        run("kwriteconfig5", *kde)
    if shutil.which("gsettings"):
        run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", theme)
    if shutil.which("xfconf-query"):
        run("xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName",
            "-n", "-t", "string", "-s", theme)
    if cache and shutil.which("gtk-update-icon-cache"):
        run("gtk-update-icon-cache", "-f", "-t", str(cache))
    if shutil.which("dbus-send"):
        run("dbus-send", "--session", "--type=signal", "/KGlobalSettings",
            "org.kde.KGlobalSettings.notifyChange", "int32:4", "int32:0")
    run("pkill", "-HUP", "-x", "xsettingsd")


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--list":
        print("\n".join(icon_themes()))
        return 0
    if len(sys.argv) == 2 and sys.argv[1] == "--current":
        print(current_theme())
        return 0
    if len(sys.argv) >= 3 and sys.argv[1] == "--set":
        selected = sys.argv[2]
        if is_managed_overlay(selected):
            overlay = theme_path(selected)
            inherited = index_value(overlay, "Inherits") if overlay else ""
            selected = inherited.split(",")[0].strip()
        if not theme_path(selected):
            return 1
        applied = selected
        if len(sys.argv) >= 4:
            applied = recolour_folders(selected, sys.argv[3])
        configure_desktops(applied, theme_path(applied))
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == "--accent":
        selected = sys.argv[2]
        if is_managed_overlay(selected):
            overlay = theme_path(selected)
            inherited = index_value(overlay, "Inherits") if overlay else ""
            selected = inherited.split(",")[0].strip()
        if not theme_path(selected):
            return 1
        applied = recolour_folders(selected, sys.argv[3])
        # Re-applying the chosen theme also repairs old Anush overlay settings
        # and tells running desktop settings daemons to invalidate icon caches.
        configure_desktops(applied, theme_path(applied))
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
