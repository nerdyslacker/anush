#!/bin/sh

# Manage the anush Quickshell instance from any working directory.
set -eu

shell_dir=$(dirname "$(dirname "$(readlink -f "$0")")")

case "${1:-restart}" in
    restart|reload)
        qs -p "$shell_dir" kill 2>/dev/null || true
        sleep 0.2
        exec qs -p "$shell_dir" -d -n
        ;;
    stop)
        exec qs -p "$shell_dir" kill
        ;;
    log)
        exec qs -p "$shell_dir" log -f
        ;;
    *)
        exec qs -p "$shell_dir" "$@"
        ;;
esac
