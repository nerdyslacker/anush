#!/usr/bin/env python3

"""Apply the active Matugen palette to GTK and/or Qt applications."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


BEGIN = "/* >>> Anush Matugen (managed) >>> */"
END = "/* <<< Anush Matugen (managed) <<< */"


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.anush-{os.getpid()}")
    try:
        temporary.write_text(text)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def run(*command: str) -> None:
    try:
        subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except OSError:
        pass


def state_path() -> Path:
    configured = os.environ.get("ANUSH_STATE_DIR")
    if configured:
        return Path(configured) / "shell-state.json"
    base = Path(os.environ.get(
        "XDG_STATE_HOME", Path.home() / ".local/state"))
    return base / "anush/shell-state.json"


def load_palette() -> tuple[dict, dict, str]:
    try:
        state = json.loads(state_path().read_text())
        palette = state["theme"]["palette"]
        if palette.get("generator") != "matugen":
            raise ValueError("active wallpaper palette was not generated by Matugen")
        semantic = palette["semantic"]
        material = palette["material"]
        mode = palette.get("mode", "dark")
        if not isinstance(semantic, dict) or not isinstance(material, dict):
            raise ValueError("Matugen palette data is incomplete")
        return semantic, material, mode
    except (OSError, KeyError, TypeError, json.JSONDecodeError) as error:
        raise ValueError(f"cannot read active palette: {error}") from error


def update_css(path: Path, generated: str) -> None:
    current = path.read_text(errors="replace") if path.exists() else ""
    pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END), re.S)
    block = f"{BEGIN}\n{generated.rstrip()}\n{END}"
    if pattern.search(current):
        updated = pattern.sub(block, current)
    else:
        separator = "\n" if current and not current.endswith("\n") else ""
        updated = current + separator + block + "\n"
    atomic_write(path, updated)


def set_ini_value(path: Path, section: str, key: str, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text(errors="replace") if path.exists() else ""
    heading = f"[{section}]"
    pattern = re.compile(rf"(?m)^{re.escape(key)}\s*=.*$")
    if heading not in text:
        separator = "\n" if text and not text.endswith("\n") else ""
        text += f"{separator}{heading}\n{key}={value}\n"
    else:
        start = text.index(heading) + len(heading)
        end = text.find("\n[", start)
        end = len(text) if end < 0 else end
        body = text[start:end]
        body = pattern.sub(f"{key}={value}", body) \
            if pattern.search(body) else body + f"\n{key}={value}"
        text = text[:start] + body + text[end:]
    atomic_write(path, text)


def ensure_ini_value(path: Path, section: str, key: str, value: str) -> None:
    """Set a default without replacing an explicit user preference."""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        text = ""
    heading = f"[{section}]"
    if heading in text:
        start = text.index(heading) + len(heading)
        end = text.find("\n[", start)
        end = len(text) if end < 0 else end
        if re.search(rf"(?m)^{re.escape(key)}\s*=", text[start:end]):
            return
    set_ini_value(path, section, key, value)


def gtk_css(semantic: dict, _material: dict) -> str:
    primary = semantic["primary"]
    background = semantic["background"]
    foreground = semantic["foreground"]
    surface = semantic["background-alt"]
    on_primary = contrast_foreground(primary, background, foreground)
    return f"""@define-color accent_color {primary};
@define-color accent_bg_color {primary};
@define-color accent_fg_color {on_primary};
@define-color window_bg_color {background};
@define-color window_fg_color {foreground};
@define-color view_bg_color {background};
@define-color view_fg_color {foreground};
@define-color headerbar_bg_color {surface};
@define-color headerbar_fg_color {foreground};
@define-color popover_bg_color {surface};
@define-color popover_fg_color {foreground};
@define-color card_bg_color {surface};
@define-color card_fg_color {foreground};
@define-color borders {semantic['border']};
@define-color error_color {semantic['alert']};
@define-color success_color {semantic['secondary']};
selection {{ background-color: {primary}; color: {on_primary}; }}"""


def gtk_theme_available(name: str) -> bool:
    data_home = Path(os.environ.get(
        "XDG_DATA_HOME", Path.home() / ".local/share"))
    roots = [Path.home() / ".themes", data_home / "themes"]
    roots.extend(Path(directory) / "themes" for directory in os.environ.get(
        "XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if directory)
    return any((root / name / "gtk-3.0").is_dir() for root in roots)


def apply_gtk(semantic: dict, material: dict, mode: str) -> None:
    gtk_theme = "adw-gtk3"
    if not gtk_theme_available(gtk_theme):
        raise ValueError(
            "Install adw-gtk-theme (adw-gtk3) before applying GTK themes")
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    css = gtk_css(semantic, material)
    for version in ("gtk-3.0", "gtk-4.0"):
        directory = config / version
        update_css(directory / "gtk.css", css)
        set_ini_value(directory / "settings.ini", "Settings",
                      "gtk-theme-name", gtk_theme)
        set_ini_value(directory / "settings.ini", "Settings",
                      "gtk-application-prefer-dark-theme",
                      "1" if mode == "dark" else "0")
    if shutil.which("gsettings"):
        run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme",
            gtk_theme)
        run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
            "prefer-dark" if mode == "dark" else "prefer-light")


def rgb(value: str) -> str:
    return ",".join(str(int(value[index:index + 2], 16))
                    for index in (1, 3, 5))


def relative_luminance(value: str) -> float:
    channels = []
    for index in (1, 3, 5):
        channel = int(value[index:index + 2], 16) / 255
        channels.append(channel / 12.92 if channel <= 0.04045
                        else ((channel + 0.055) / 1.055) ** 2.4)
    return 0.2126 * channels[0] + 0.7152 * channels[1] \
        + 0.0722 * channels[2]


def contrast_foreground(background: str, *candidates: str) -> str:
    background_luminance = relative_luminance(background)

    def ratio(candidate: str) -> float:
        candidate_luminance = relative_luminance(candidate)
        light = max(background_luminance, candidate_luminance)
        dark = min(background_luminance, candidate_luminance)
        return (light + 0.05) / (dark + 0.05)

    return max(candidates, key=ratio)


def qt_scheme(semantic: dict, _material: dict) -> str:
    background = rgb(semantic["background"])
    surface = rgb(semantic["background-alt"])
    raised = surface
    foreground = rgb(semantic["foreground"])
    primary = rgb(semantic["primary"])
    secondary = rgb(semantic["secondary"])
    error = rgb(semantic["alert"])
    disabled = rgb(semantic["disabled"])
    positive = secondary
    # The shell accent is refined after Matugen runs, so Matugen's on_primary
    # may belong to a different colour. Derive readable selection text from
    # the actual semantic accent written into this scheme.
    on_primary = rgb(contrast_foreground(
        semantic["primary"], semantic["background"], semantic["foreground"]))
    groups = []

    # qt5ct/qt6ct and KDE consume the same KColorScheme groups. Supplying the
    # complete set matters: otherwise controls silently fall back to the host
    # palette and the selected scheme looks only partially themed.
    group_backgrounds = {
        "Button": (surface, raised),
        "Complementary": (surface, background),
        "Header": (surface, background),
        "Header][Inactive": (background, surface),
        "Tooltip": (surface, background),
        "View": (surface, background),
        "Window": (surface, background),
    }
    for name, (alternate, normal) in group_backgrounds.items():
        groups.append(f"""[Colors:{name}]
BackgroundAlternate={alternate}
BackgroundNormal={normal}
DecorationFocus={primary}
DecorationHover={primary}
ForegroundActive={foreground}
ForegroundInactive={disabled}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={foreground}
ForegroundNormal={foreground}
ForegroundPositive={positive}
ForegroundVisited={secondary}
""")
    groups.append(f"""[Colors:Selection]
BackgroundAlternate={primary}
BackgroundNormal={primary}
DecorationFocus={primary}
DecorationHover={primary}
ForegroundActive={on_primary}
ForegroundInactive={on_primary}
ForegroundLink={secondary}
ForegroundNegative={error}
ForegroundNeutral={on_primary}
ForegroundNormal={on_primary}
ForegroundPositive={secondary}
ForegroundVisited={secondary}
""")
    effects = f"""[ColorEffects:Disabled]
Color={disabled}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={disabled}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

"""
    return effects + "\n".join(groups) + f"""\n[General]
ColorScheme=AnushMatugen
Name=Anush Matugen
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={background}
activeBlend={foreground}
activeForeground={foreground}
inactiveBackground={surface}
inactiveBlend={disabled}
inactiveForeground={disabled}
"""


def apply_qt(semantic: dict, material: dict) -> None:
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    scheme = qt_scheme(semantic, material)
    kde_scheme = data / "color-schemes/AnushMatugen.colors"
    atomic_write(kde_scheme, scheme)
    for toolkit in ("qt5ct", "qt6ct"):
        scheme_path = config / toolkit / "colors/anush-matugen.conf"
        atomic_write(scheme_path, scheme)
        toolkit_config = config / toolkit / f"{toolkit}.conf"
        set_ini_value(toolkit_config, "Appearance",
                      "color_scheme_path", str(scheme_path))
        # A path alone only makes the palette appear in QtCt's selector.
        # custom_palette is what makes the platform theme actually load it.
        set_ini_value(toolkit_config, "Appearance", "custom_palette", "true")
        ensure_ini_value(toolkit_config, "Appearance", "style", "Fusion")
    command = shutil.which("kwriteconfig6") or shutil.which("kwriteconfig5")
    if command:
        run(command, "--file", "kdeglobals", "--group", "General", "--key",
            "ColorScheme", "AnushMatugen")


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {"gtk", "qt", "all"}:
        print("usage: apply-application-theme gtk|qt|all", file=sys.stderr)
        return 2
    try:
        semantic, material, mode = load_palette()
    except ValueError as error:
        print(f"apply-application-theme: {error}", file=sys.stderr)
        return 1
    try:
        if sys.argv[1] in {"gtk", "all"}:
            apply_gtk(semantic, material, mode)
        if sys.argv[1] in {"qt", "all"}:
            apply_qt(semantic, material)
    except (OSError, ValueError) as error:
        print(f"apply-application-theme: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
