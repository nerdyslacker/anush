def default_bindings() -> list[dict]:
    actions = [
        ("h", "focusleft"), ("j", "focusdown"), ("k", "focusup"),
        ("l", "focusright"), ("Shift + h", "moveleft"),
        ("Shift + j", "movedown"), ("Shift + k", "moveup"),
        ("Shift + l", "moveright"), ("Control + h", "resizeleft"),
        ("Control + j", "resizedown"), ("Control + k", "resizeup"),
        ("Control + l", "resizeright"), ("space", "togglefloating"),
        ("f", "togglefullscreen"), ("t", "toggle_tabbed"),
        ("g", "layout_next"), ("slash", "show_bindings"),
        ("Control + Alt + h", "show_bindings"),
        ("Control + Alt + t", "show_datetime"),
        ("Control + Alt + b", "show_battery"),
        ("Control + r", "reminder_new"),
        ("Control + Alt + r", "reminder_show_all"),
        ("Control + Shift + r", "reminder_clear_all"),
        ("grave", "scratchpad_toggle 1"),
        ("Shift + grave", "scratchpad_toggle_float 2"),
        ("Control + grave", "scratchpad_remove 1"),
        ("Shift + q", "close_window"), ("Shift + r", "reload_config"),
        ("n", "ws_next"), ("p", "ws_prev"),
        ("Control + n", "tag_next"), ("Control + p", "tag_prev"),
        ("comma", "focus_output_prev"), ("period", "focus_output_next"),
        ("Shift + comma", "move_to_output_prev"),
        ("Shift + period", "move_to_output_next"),
    ]
    result = [{"type": "call", "combo": "mod + " + combo, "value": action}
              for combo, action in actions]
    for number in range(1, 10):
        result.append({"type": "workspace", "combo": f"mod + {number}",
                       "value": f"view {number}"})
        result.append({"type": "workspace", "combo": f"mod + Shift + {number}",
                       "value": f"tag {number}"})
    terminal = os.environ.get("TERMINAL", "").strip()
    if not terminal:
        terminal = next((name for name in ("kitty", "foot", "alacritty", "xterm")
                         if shutil.which(name)), "")
    if terminal:
        result.insert(0, {"type": "bind", "combo": "mod + Return", "value": terminal})
    return result


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] == '"':
        return value[1:-1].replace(r'\"', '"').replace(r'\\', '\\')
    return value


def quote(value: object) -> str:
    return '"' + str(value).replace('\\', r'\\').replace('"', r'\"') + '"'


def active_path() -> Path | None:
    command = shutil.which("skarwm-msg")
    if command:
        try:
            result = subprocess.run([command, "get-version"], text=True,
                                    capture_output=True, timeout=2, check=False)
            data = json.loads(result.stdout)
            loaded = data.get("loaded_config_file_name")
            if loaded:
                return Path(loaded).expanduser()
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    configured = os.environ.get("SKARWM_CONFIG")
    if configured:
        return Path(configured).expanduser()
    root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    user_path = root / "skarwm/default.conf"
    if user_path.exists():
        return user_path
    system_path = Path("/etc/skarwm/default.conf")
    if system_path.exists():
        return system_path
    return user_path


def empty_document(path: Path) -> dict:
    return {
        "path": str(path), "exists": path.exists(), "settings": dict(SETTINGS),
        "barBlocks": [], "autostart": ["anushctl start"],
        "autostartIds": ["anush"],
        "bindings": default_bindings(), "rules": [],
        "workspaceLayouts": [], "virtualScreens": [], "extras": [],
    }


def read_assignments(path: Path, loaded=None, stack=None):
    loaded = set() if loaded is None else loaded
    stack = [] if stack is None else stack
    normalized = path.expanduser().resolve()
    if normalized in stack:
        chain = " -> ".join(str(item) for item in stack + [normalized])
        raise ValueError(f"skarwm import cycle: {chain}")
    if normalized in loaded:
        return []
    if not normalized.is_file():
        raise ValueError(f"skarwm configuration does not exist: {normalized}")
    loaded.add(normalized)
    stack.append(normalized)
    assignments = []
    section = ""
    for number, original in enumerate(
            normalized.read_text(encoding="utf-8").splitlines(), 1):
        line = original.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if not section or "=" not in original:
            raise ValueError(f"{normalized}:{number}: malformed configuration")
        key, value = (part.strip() for part in original.split("=", 1))
        key, value = unquote(key), unquote(value)
        if section == "import":
            optional = value.startswith("?")
            imported = Path(value[1:] if optional else value).expanduser()
            if not imported.is_absolute():
                imported = normalized.parent / imported
            if optional and not imported.exists():
                continue
            assignments.extend(read_assignments(imported, loaded, stack))
        else:
            assignments.append((section, key, value))
    stack.pop()
    return assignments


def normalized_combo(combo: str) -> str:
    return "+".join(part.strip().lower() for part in combo.split("+"))


def parse_rule(properties: dict) -> dict:
    matches = [(key, properties[key]) for key in ("class", "instance", "title")
               if properties.get(key)]
    field, pattern = matches[0] if matches else ("class", "Application")
    effects = []
    for key, value in matches[1:]:
        effects.extend((key, quote(value)))
    if "workspace" in properties:
        effects.extend(("workspace", properties["workspace"]))
    for key in ("floating", "decorate"):
        if key in properties:
            effects.append(key if properties[key].lower() == "true"
                           else f"{key} false")
    return {"field": field, "pattern": pattern,
            "effects": " ".join(effects) or "floating"}


def parse(path: Path) -> dict:
    document = empty_document(path)
    if not path.exists():
        return document
    document.update(barBlocks=[], autostart=[], autostartIds=[], bindings=[], rules=[],
                    workspaceLayouts=[], virtualScreens=[], extras=[])
    objects: dict[str, dict[str, str]] = {}
    object_order: list[str] = []
    autostarts: dict[str, str] = {}
    autostart_order: list[str] = []
    bindings: dict[str, dict] = {}
    binding_order: list[str] = []

    for section, key, value in read_assignments(path):
        if section == "window" and key == "gap":
            try:
                gap = int(value)
            except ValueError:
                gap = value
            document["settings"]["outer_gap"] = gap
            document["settings"]["inner_gap"] = gap
            continue
        setting = SETTING_NAMES.get((section, key))
        if setting:
            if setting in BOOL_KEYS:
                document["settings"][setting] = value.lower() == "true"
            elif setting in INT_RANGES:
                try:
                    document["settings"][setting] = int(value)
                except ValueError:
                    document["settings"][setting] = value
            else:
                document["settings"][setting] = value
            continue
        if section in ("bind", "call", "workspace.bindings"):
            kind = "workspace" if section == "workspace.bindings" else section
            normalized = normalized_combo(key)
            if normalized not in bindings:
                binding_order.append(normalized)
            bindings[normalized] = {"type": kind, "combo": key, "value": value}
            continue
        if section == "autostart":
            if key not in autostarts:
                autostart_order.append(key)
            autostarts[key] = value
            continue
        named = any(section.startswith(prefix) for prefix in
                    ("rule.", "workspace.", "virtual_screen.", "bar.block."))
        if named:
            if section not in objects:
                objects[section] = {}
                object_order.append(section)
            objects[section][key] = value
            continue
        document["extras"].append(f"[{section}] {key} = {value}")

    document["autostart"] = [autostarts[key] for key in autostart_order]
    document["autostartIds"] = list(autostart_order)
    document["bindings"] = [bindings[key] for key in binding_order]
    for section in object_order:
        properties = objects[section]
        if section.startswith("rule."):
            rule = parse_rule(properties)
            rule["id"] = section[len("rule."):]
            document["rules"].append(rule)
        elif section.startswith("workspace."):
            identifier = section[len("workspace."):]
            document["workspaceLayouts"].append({
                "workspace": identifier, "layout": properties.get("layout", "scrolling-tile"),
                "icon": properties.get("icon", identifier), "name": properties.get("name", ""),
            })
        elif section.startswith("virtual_screen."):
            document["virtualScreens"].append({
                "output": section[len("virtual_screen."):],
                "ratio": properties.get("ratio", 75), "offset": properties.get("offset", 0),
            })
        else:
            kind = properties.get("type", "workspaces")
            document["barBlocks"].append({
                "id": section[len("bar.block."):],
                "kind": kind, "alignment": properties.get("position", "left"),
                "name": properties.get("label", properties.get("icon", "")),
                "interval": properties.get("interval", 1),
                "timeout": properties.get("timeout", 1),
                "command": properties.get("command", ""),
                "foreground": properties.get("foreground", ""),
                "background": properties.get("background", ""),
            })
    return document


def require_text(value: object, label: str, limit: int = 1024) -> str:
    text = str(value).strip()
    if not text or "\n" in text or "\r" in text or len(text) >= limit:
        raise ValueError(f"{label} is empty or too long")
    return text


def integer(value: object, label: str, low: int, high: int) -> int:
    try:
        number = int(value)
    except (TypeError, ValueError) as failure:
        raise ValueError(f"{label} must be a number") from failure
    if number < low or number > high:
        raise ValueError(f"{label} must be between {low} and {high}")
    return number


def serialize(document: dict) -> str:
    settings = document.get("settings", {})
    lines = ["# skarwm configuration — managed by anush"]
    grouped_settings: dict[str, list[tuple[str, object]]] = {}
    for key, default in SETTINGS.items():
        value = settings.get(key, default)
        if key in BOOL_KEYS:
            value = "true" if value is True else "false"
        elif key in INT_RANGES:
            value = integer(value, key, *INT_RANGES[key])
        elif key in COLOR_KEYS:
            value = require_text(value, key, 16).upper()
            if len(value) != 7 or value[0] != "#" or any(c not in "0123456789ABCDEF" for c in value[1:]):
                raise ValueError(f"{key} must be a #RRGGBB color")
        elif key == "mod_key":
            value = require_text(value, key, 32)
        elif key == "animation_easing" and value not in ("linear", "ease_out_cubic"):
            raise ValueError("animation_easing must be linear or ease_out_cubic")
        elif key == "decoration_color_source" and value not in ("active-border", "accent", "explicit"):
            raise ValueError("invalid decoration color source")
        elif key == "bar_position" and value not in ("top", "bottom"):
            raise ValueError("bar_position must be top or bottom")
        elif key == "bar_font_weight" and value not in ("normal", "medium", "bold"):
            raise ValueError("invalid bar font weight")
        elif key == "bar_font":
            value = quote(require_text(value, key, 128))
        section, config_key = SETTING_PATHS[key]
        grouped_settings.setdefault(section, []).append((config_key, value))
    for section, values in grouped_settings.items():
        lines.extend(("", f"[{section}]"))
        lines.extend(f"{key} = {value}" for key, value in values)

    lines.extend(["", "# Built-in bar blocks"])
    for index, item in enumerate(document.get("barBlocks", []), 1):
        kind = require_text(item.get("kind"), "bar block kind", 20)
        align = item.get("alignment", "left")
        if align not in ("left", "center", "right"):
            raise ValueError("bar block alignment must be left, center, or right")
        if kind not in ("workspaces", "layout", "title", "script", "systray",
                        "button", "audio", "bluetooth", "network"):
            raise ValueError(f"unknown bar block kind: {kind}")
        identifier = str(item.get("id", "")).strip() or f"anush-{index}"
        lines.extend(("", f"[bar.block.{identifier}]", f"type = {kind}",
                      f"position = {align}"))
        name = str(item.get("name", "")).strip()
        command = str(item.get("command", "")).strip()
        if kind == "button":
            lines.append(f"label = {require_text(name, 'button label', 65)}")
            lines.append(f"command = {require_text(command, 'button command')}")
        elif kind == "script":
            lines.append(f"icon = {require_text(name, 'script icon', 65)}")
            interval = integer(item.get("interval"), "script interval", 1, 86400)
            timeout = integer(item.get("timeout"), "script timeout", 1, 60)
            lines.extend((f"interval = {interval}", f"timeout = {timeout}",
                          f"command = {require_text(command, 'script command')}"))
        elif kind in ("audio", "bluetooth", "network"):
            lines.append(f"icon = {require_text(name, 'status icon', 65)}")
            if command:
                lines.append(f"command = {command}")
        for color in ("foreground", "background"):
            if str(item.get(color, "")).strip():
                lines.append(f"{color} = {item[color]}")

    lines.extend(["", "# Autostart"])
    lines.append("[autostart]")
    autostart_ids = document.get("autostartIds", [])
    for index, command in enumerate(document.get("autostart", []), 1):
        identifier = (str(autostart_ids[index - 1]).strip()
                      if index <= len(autostart_ids) else "")
        lines.append(f"{identifier or f'anush-{index}'} = "
                     f"{require_text(command, 'autostart command')}")

    lines.extend(["", "# Key bindings and workspace bindings"])
    binding_groups: dict[str, list[tuple[str, str]]] = {}
    for item in document.get("bindings", []):
        kind = item.get("type")
        if kind not in ("bind", "call", "workspace"):
            raise ValueError("binding type must be bind, call, or workspace")
        combo = require_text(item.get("combo"), "binding combo", 256)
        value = require_text(item.get("value"), "binding action")
        section = "workspace.bindings" if kind == "workspace" else kind
        binding_groups.setdefault(section, []).append((combo, value))
    for section, bindings in binding_groups.items():
        lines.extend(("", f"[{section}]"))
        lines.extend(f"{quote(combo)} = {value}" for combo, value in bindings)

    lines.extend(["", "# Workspace configuration and virtual screens"])
    seen_workspaces = set()
    for item in document.get("workspaceLayouts", []):
        workspace = integer(item.get("workspace"), "workspace", 1, 64)
        if workspace in seen_workspaces:
            raise ValueError(f"duplicate workspace layout: {workspace}")
        seen_workspaces.add(workspace)
        layout = item.get("layout")
        if layout not in ("scrolling-tile", "vertical-scrolling-tile", "dwindle", "monocle", "floating"):
            raise ValueError(f"invalid workspace layout: {layout}")
        icon = require_text(item.get("icon", str(workspace)), "workspace icon", 65)
        name = str(item.get("name", "")).strip()
        if len(name) >= 129 or "\n" in name or "\r" in name:
            raise ValueError("workspace name is too long")
        lines.extend(("", f"[workspace.{workspace}]", f"layout = {layout}",
                      f"icon = {icon}"))
        if name:
            lines.append(f"name = {name}")
    seen_outputs = set()
    for item in document.get("virtualScreens", []):
        output = require_text(item.get("output"), "virtual screen output", 128)
        if output in seen_outputs:
            raise ValueError(f"duplicate virtual screen output: {output}")
        seen_outputs.add(output)
        ratio = integer(item.get("ratio"), "split ratio", 10, 90)
        offset = integer(item.get("offset", 0), "split offset", -100000, 100000)
        lines.extend(("", f"[virtual_screen.{output}]", "mode = split",
                      f"ratio = {ratio}", f"offset = {offset}"))

    lines.extend(["", "# Window rules"])
    for index, item in enumerate(document.get("rules", []), 1):
        field = item.get("field")
        if field not in ("class", "instance", "title"):
            raise ValueError("rule field must be class, instance, or title")
        pattern = require_text(item.get("pattern"), "rule pattern", 512)
        effects = require_text(item.get("effects"), "rule effects", 512)
        properties = {field: pattern}
        tokens = shlex.split(effects)
        cursor = 0
        while cursor < len(tokens):
            token = tokens[cursor]
            if token in ("workspace", "class", "instance", "title") and cursor + 1 < len(tokens):
                properties[token] = tokens[cursor + 1]
                cursor += 2
            elif token in ("floating", "decorate"):
                value = "true"
                if cursor + 1 < len(tokens) and tokens[cursor + 1] in ("true", "false"):
                    value = tokens[cursor + 1]
                    cursor += 1
                properties[token] = value
                cursor += 1
            else:
                raise ValueError(f"unsupported rule effect: {token}")
        identifier = str(item.get("id", "")).strip() or f"anush-{index}"
        lines.extend(("", f"[rule.{identifier}]"))
        for property_name in ("class", "instance", "title", "workspace", "floating", "decorate"):
            if property_name in properties:
                lines.append(f"{property_name} = {properties[property_name]}")

    extras = document.get("extras", [])
    if extras:
        lines.extend(["", "# Advanced entries preserved by anush"])
        for raw in extras:
            raw = require_text(raw, "advanced entry", 4096)
            match = re.fullmatch(r"\[([^]]+)]\s+([^=]+?)\s*=\s*(.*)", raw)
            if not match:
                raise ValueError("advanced entry must be '[section] key = value'")
            lines.extend(("", f"[{match.group(1)}]",
                          f"{match.group(2).strip()} = {match.group(3)}"))
    return "\n".join(lines) + "\n"


def save(document: dict, reload_wm: bool) -> dict:
    root = active_path()
    if root is None:
        raise ValueError("No user configuration path is available")
    content = serialize(document)
    helper = Path(__file__).with_name("config-set")
    result = subprocess.run([sys.executable, str(helper), "--path", str(root)], text=True,
                            capture_output=True, timeout=8, check=False)
    if result.returncode != 0 or not result.stdout.strip():
        raise RuntimeError(result.stderr.strip() or "Cannot create anush.conf")
    path = Path(result.stdout.strip())
    previous = path.read_bytes() if path.exists() else None
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    descriptor, temporary_name = tempfile.mkstemp(prefix=".default.conf.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        if reload_wm:
            command = shutil.which("skarwm-msg")
            if not command:
                raise RuntimeError("Saved, but skarwm-msg was not found")
            result = subprocess.run([command, "reload"], text=True,
                                    capture_output=True, timeout=8, check=False)
            if result.returncode != 0:
                detail = (result.stderr or result.stdout).strip()
                raise RuntimeError(detail or "skarwm rejected the configuration")
    except Exception:
        temporary.unlink(missing_ok=True)
        if path.exists() and previous is None:
            path.unlink()
        elif previous is not None:
            path.write_bytes(previous)
            os.chmod(path, mode)
        if reload_wm and shutil.which("skarwm-msg"):
            subprocess.run([shutil.which("skarwm-msg"), "reload"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        raise
    return parse(root)


def main() -> int:
    try:
        command = sys.argv[1] if len(sys.argv) > 1 else "read"
        path = active_path()
        if path is None:
            raise ValueError("Cannot determine skarwm configuration path")
        if command == "read":
            result = parse(path)
        elif command in ("save", "save-reload"):
            result = save(json.loads(sys.stdin.readline()), command == "save-reload")
        else:
            raise ValueError(f"Unknown command: {command}")
        print(json.dumps({"success": True, "document": result}, ensure_ascii=False))
        return 0
    except Exception as failure:
        print(json.dumps({"success": False, "error": str(failure)}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
