BOOL_KEYS = {
    "decorations_enabled", "decoration_show_title", "focus_follows_mouse",
    "animations", "bar_enabled",
}
INT_RANGES = {
    "outer_gap": (-4096, 4096), "inner_gap": (-4096, 4096),
    "border_width": (0, 4096), "corner_radius": (0, 4096),
    "decoration_titlebar_height": (16, 128),
    "decoration_border_width": (0, 32),
