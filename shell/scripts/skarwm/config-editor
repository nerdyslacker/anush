COLOR_KEYS = {
    "norm_outer_border", "sel_outer_border", "decoration_accent",
    "decoration_active_background", "decoration_inactive_background",
    "decoration_active_foreground", "decoration_inactive_foreground",
    "decoration_active_border", "decoration_inactive_border", "bar_foreground",
    "bar_background", "bar_tag_foreground", "bar_tag_background",
    "bar_block_foreground", "bar_block_background",
}
ALIASES = {
    "modkey": "mod_key", "titlebar_height": "decoration_titlebar_height",
    "bar_workspace_count": "bar_tag_count",
    "bar_workspace_foreground": "bar_tag_foreground",
    "bar_workspace_background": "bar_tag_background",
}
DIRECTIVES = {"bind", "call", "workspace", "autostart", "rule", "bar_block",
              "virtual_screen"}


def default_bindings() -> list[dict]:
    actions = [
        ("h", "focusleft"), ("j", "focusdown"), ("k", "focusup"),
        ("l", "focusright"), ("Shift + h", "moveleft"),
        ("Shift + j", "movedown"), ("Shift + k", "moveup"),
        ("Shift + l", "moveright"), ("Control + h", "resizeleft"),
        ("Control + j", "resizedown"), ("Control + k", "resizeup"),
        ("Control + l", "resizeright"), ("space", "togglefloating"),
        ("f", "togglefullscreen"), ("t", "toggle_tabbed"),
        ("g", "layout_next"), ("slash", "show_bindings"),
        ("Control + Alt + h", "show_bindings"),
        ("Control + Alt + t", "show_datetime"),
        ("Control + Alt + b", "show_battery"),
        ("Control + r", "reminder_new"),
        ("Control + Alt + r", "reminder_show_all"),
        ("Control + Shift + r", "reminder_clear_all"),
        ("grave", "scratchpad_toggle 1"),
        ("Shift + grave", "scratchpad_toggle_float 2"),
        ("Control + grave", "scratchpad_remove 1"),
        ("Shift + q", "close_window"), ("Shift + r", "reload_config"),
        ("n", "ws_next"), ("p", "ws_prev"),
        ("Control + n", "tag_next"), ("Control + p", "tag_prev"),
        ("comma", "focus_output_prev"), ("period", "focus_output_next"),
        ("Shift + comma", "move_to_output_prev"),
        ("Shift + period", "move_to_output_next"),
    ]
    result = [{"type": "call", "combo": "mod + " + combo, "value": action}
              for combo, action in actions]
    for number in range(1, 10):
        result.append({"type": "workspace", "combo": f"mod + {number}",
                       "value": f"view {number}"})
        result.append({"type": "workspace", "combo": f"mod + Shift + {number}",
                       "value": f"tag {number}"})
    terminal = os.environ.get("TERMINAL", "").strip()
    if not terminal:
        terminal = next((name for name in ("kitty", "foot", "alacritty", "xterm")
                         if shutil.which(name)), "")
    if terminal:
        result.insert(0, {"type": "bind", "combo": "mod + Return", "value": terminal})
    return result


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] == '"':
        return value[1:-1].strip()
    return value


def quote(value: object) -> str:
    # skarwm removes one surrounding quote pair; it intentionally does not use
    # shell/JSON escaping, so embedded quotes must remain byte-for-byte intact.
    return '"' + str(value) + '"'


def active_path() -> Path | None:
    command = shutil.which("skarwm-msg")
    if command:
        try:
            result = subprocess.run([command, "get-version"], text=True,
                                    capture_output=True, timeout=2, check=False)
            data = json.loads(result.stdout)
            loaded = data.get("loaded_config_file_name")
            if loaded:
                return Path(loaded).expanduser()
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    configured = os.environ.get("SKARWM_CONFIG")
    if configured:
        return Path(configured).expanduser()
    root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    preferred = root / "skarwm/skarwm.rc"
    legacy = root / "skarwm/config.rc"
    if preferred.exists():
        return preferred
    if legacy.exists():
        return legacy
    for system_path in (Path("/etc/skarwm/skarwm.rc"),
                        Path("/etc/skarwm/config.rc")):
        if system_path.exists():
            return system_path
    return preferred


def empty_document(path: Path) -> dict:
    source = str(path.resolve())
    return {
        "path": source, "exists": path.exists(), "settings": dict(SETTINGS),
        "barBlocks": [], "autostart": ["anushctl start"],
        "bindings": default_bindings(), "rules": [],
        "workspaceLayouts": [], "virtualScreens": [], "extras": [],
        "_sources": [source], "_imports": {source: []},
        "_fileSettings": {source: {}},
        "_owners": {"autostart": [source], "extras": []},
        "_serialized": {},
    }


def parse(path: Path) -> dict:
    document = empty_document(path)
    if not path.exists():
        return document
    # An existing rc graph replaces the built-in lists completely. Source
    # metadata lets the editor write each row back to the file it came from.
    for name in ("barBlocks", "autostart", "bindings", "rules",
                 "workspaceLayouts", "virtualScreens", "extras"):
        document[name] = []
    document["_owners"] = {"autostart": [], "extras": []}
    document["_sources"] = []
    document["_imports"] = {}
    document["_fileSettings"] = {}
    root = path.resolve()
    document["path"] = str(root)
    seen: set[Path] = set()
    stack: list[Path] = []

    def add_extra(line: str, source: str) -> None:
        document["extras"].append(line)
        document["_owners"]["extras"].append(source)

    def parse_file(file_path: Path) -> None:
        resolved = file_path.resolve()
        if resolved in stack:
            chain = " -> ".join(str(item) for item in stack + [resolved])
            raise ValueError(f"skarwm config import cycle: {chain}")
        if resolved in seen:
            return
        if len(stack) >= 64:
            raise ValueError(f"skarwm config import depth exceeds 64 at {resolved}")
        if not resolved.is_file():
            raise ValueError(f"Cannot read imported skarwm config: {resolved}")
        seen.add(resolved)
        stack.append(resolved)
        source = str(resolved)
        document["_sources"].append(source)
        document["_imports"][source] = []
        document["_fileSettings"][source] = {}
        try:
            for original in resolved.read_text(encoding="utf-8").splitlines():
                line = original.strip()
                if not line or line.startswith("#"):
                    continue
                if ":" not in line:
                    add_extra(line, source)
                    continue
                key, rest = (part.strip() for part in line.split(":", 1))
                canonical = ALIASES.get(key, key)
                if key == "import":
                    target = unquote(rest)
                    if not target:
                        raise ValueError(f"Empty skarwm import in {resolved}")
                    document["_imports"][source].append(rest)
                    imported = Path(target).expanduser()
                    if not imported.is_absolute():
                        imported = resolved.parent / imported
                    parse_file(imported)
                    continue
                if key == "gap":
                    try:
                        value = int(unquote(rest))
                        for setting in ("outer_gap", "inner_gap"):
                            document["settings"][setting] = value
                            document["_fileSettings"][source][setting] = value
                    except ValueError:
                        add_extra(line, source)
                    continue
                if canonical in SETTINGS:
                    value: object = unquote(rest)
                    if canonical in BOOL_KEYS:
                        value = str(value).lower() in ("true", "1")
                    elif canonical in INT_RANGES:
                        try:
                            value = int(str(value))
                        except ValueError:
                            pass
                    document["settings"][canonical] = value
                    document["_fileSettings"][source][canonical] = value
                elif key.startswith(("workspace-", "workspace_")):
                    prefix = "workspace-" if key.startswith("workspace-") else "workspace_"
                    try:
                        workspace = int(key[len(prefix):])
                    except ValueError:
                        add_extra(line, source)
                        continue
                    parts = [part.strip() for part in rest.split(":")]
                    if 1 <= workspace <= 64 and len(parts) in (2, 3):
                        document["workspaceLayouts"].append({"workspace": workspace,
                            "layout": parts[0], "icon": unquote(parts[1]),
                            "name": unquote(parts[2]) if len(parts) == 3 else "",
                            "_source": source})
                    else:
                        add_extra(line, source)
                elif key in ("bind", "call", "workspace"):
                    parts = rest.split(":", 1)
                    if len(parts) == 2:
                        document["bindings"].append({
                            "type": key, "combo": parts[0].strip(),
                            "value": unquote(parts[1]), "_source": source,
                        })
                    else:
                        add_extra(line, source)
                elif key == "autostart":
                    document["autostart"].append(unquote(rest))
                    document["_owners"]["autostart"].append(source)
                elif key == "rule":
                    parts = rest.split(":", 2)
                    if len(parts) == 3:
                        document["rules"].append({"field": parts[0].strip(),
                            "pattern": unquote(parts[1]), "effects": parts[2].strip(),
                            "_source": source})
                    else:
                        add_extra(line, source)
                elif key == "bar_block":
                    parts = [part.strip() for part in rest.split(":")]
                    kind = parts[0] if parts else "workspaces"
                    item = {"kind": kind, "alignment": parts[1] if len(parts) > 1 else "left",
                            "name": "", "interval": 1, "timeout": 1, "command": "",
                            "_source": source}
                    if kind == "script" and len(parts) >= 6:
                        item.update(name=parts[2], interval=parts[3], timeout=parts[4],
                                    command=unquote(":".join(parts[5:])))
                    elif kind == "button" and len(parts) >= 4:
                        item.update(name=parts[2], command=unquote(":".join(parts[3:])))
                    elif kind not in ("workspaces", "systray"):
                        add_extra(line, source)
                        continue
                    document["barBlocks"].append(item)
                elif key == "virtual_screen":
                    parts = [part.strip() for part in rest.split(":")]
                    if len(parts) in (3, 4) and parts[1] == "split":
                        document["virtualScreens"].append({"output": parts[0],
                            "ratio": parts[2], "offset": parts[3] if len(parts) == 4 else "0",
                            "_source": source})
                    else:
                        add_extra(line, source)
                elif key in ("workspace_layout", "tag_layout"):
                    parts = [part.strip() for part in rest.split(":", 1)]
                    if len(parts) == 2:
                        document["workspaceLayouts"].append({"workspace": parts[0],
                            "layout": parts[1], "icon": parts[0], "name": "",
                            "_source": source})
                    else:
                        add_extra(line, source)
                else:
                    add_extra(line, source)
        finally:
            stack.pop()

    parse_file(root)
    document["_serialized"] = {
        source: serialize_source(document, source)
        for source in document["_sources"]
    }
    return document


def require_text(value: object, label: str, limit: int = 1024) -> str:
    text = str(value).strip()
    if not text or "\n" in text or "\r" in text or len(text) >= limit:
        raise ValueError(f"{label} is empty or too long")
    return text


def integer(value: object, label: str, low: int, high: int) -> int:
    try:
        number = int(value)
    except (TypeError, ValueError) as failure:
        raise ValueError(f"{label} must be a number") from failure
    if number < low or number > high:
        raise ValueError(f"{label} must be between {low} and {high}")
    return number


def item_source(item: object, root: str) -> str:
    return str(item.get("_source", root)) if isinstance(item, dict) else root


def serialize_source(document: dict, source: str) -> str:
    root = str(document.get("path", source))
    is_root = source == root
    settings = (document.get("settings", {}) if is_root else
                document.get("_fileSettings", {}).get(source, {}))
    lines = ["# skarwm configuration — managed by anush"]
    imports = document.get("_imports", {}).get(source, [])
    if imports:
        lines.extend(["", "# Imported configuration"])
        lines.extend("import : " + require_text(value, "import path", 4096)
                     for value in imports)
    if settings:
        lines.extend(["", "# General and window appearance"])
    keys = SETTINGS if is_root else settings
    for key in keys:
        default = SETTINGS[key]
        value = settings.get(key, default)
        if key in BOOL_KEYS:
            value = "true" if value is True else "false"
        elif key in INT_RANGES:
            value = integer(value, key, *INT_RANGES[key])
        elif key in COLOR_KEYS:
            value = require_text(value, key, 16).upper()
            if len(value) != 7 or value[0] != "#" or any(c not in "0123456789ABCDEF" for c in value[1:]):
                raise ValueError(f"{key} must be a #RRGGBB color")
        elif key == "mod_key":
            value = require_text(value, key, 32)
        elif key == "animation_easing" and value not in ("linear", "ease_out_cubic"):
            raise ValueError("animation_easing must be linear or ease_out_cubic")
        elif key == "decoration_color_source" and value not in ("active-border", "accent", "explicit"):
            raise ValueError("invalid decoration color source")
        elif key == "bar_position" and value not in ("top", "bottom"):
            raise ValueError("bar_position must be top or bottom")
        elif key == "bar_font_weight" and value not in ("normal", "medium", "bold"):
            raise ValueError("invalid bar font weight")
        elif key == "bar_font":
            value = quote(require_text(value, key, 128))
        lines.append(f"{key} : {value}")

    blocks = [item for item in document.get("barBlocks", [])
              if item_source(item, root) == source]
    if blocks:
        lines.extend(["", "# Built-in bar blocks"])
    for item in blocks:
        kind = require_text(item.get("kind"), "bar block kind", 20)
        align = item.get("alignment", "left")
        if align not in ("left", "center", "right"):
            raise ValueError("bar block alignment must be left, center, or right")
        if kind in ("workspaces", "systray"):
            lines.append(f"bar_block : {kind} : {align}")
        elif kind == "button":
            name = require_text(item.get("name"), "button label", 65)
            command = require_text(item.get("command"), "button command")
            lines.append(f"bar_block : button : {align} : {name} : {quote(command)}")
        elif kind == "script":
            name = require_text(item.get("name"), "script name", 65)
            interval = integer(item.get("interval"), "script interval", 1, 86400)
            timeout = integer(item.get("timeout"), "script timeout", 1, 60)
            command = require_text(item.get("command"), "script command")
            lines.append(f"bar_block : script : {align} : {name} : {interval} : {timeout} : {quote(command)}")
        else:
            raise ValueError(f"unknown bar block kind: {kind}")

    owners = document.get("_owners", {})
    autostarts = [(command, owners.get("autostart", [])[index]
                   if index < len(owners.get("autostart", [])) else root)
                  for index, command in enumerate(document.get("autostart", []))]
    if any(owner == source for _, owner in autostarts):
        lines.extend(["", "# Autostart"])
    for command, owner in autostarts:
        if owner != source:
            continue
        lines.append("autostart : " + quote(require_text(command, "autostart command")))

    bindings = [item for item in document.get("bindings", [])
                if item_source(item, root) == source]
    if bindings:
        lines.extend(["", "# Key bindings and workspace bindings"])
    for item in bindings:
        kind = item.get("type")
        if kind not in ("bind", "call", "workspace"):
            raise ValueError("binding type must be bind, call, or workspace")
        combo = require_text(item.get("combo"), "binding combo", 256)
        value = require_text(item.get("value"), "binding action")
        lines.append(f"{kind} : {combo} : {quote(value) if kind == 'bind' else value}")

    workspace_items = [item for item in document.get("workspaceLayouts", [])
                       if item_source(item, root) == source]
    virtual_items = [item for item in document.get("virtualScreens", [])
                     if item_source(item, root) == source]
    if workspace_items or virtual_items:
        lines.extend(["", "# Workspace configuration and virtual screens"])
    seen_workspaces = set()
    for item in workspace_items:
        workspace = integer(item.get("workspace"), "workspace", 1, 2147483647)
        if workspace in seen_workspaces:
            raise ValueError(f"duplicate workspace layout: {workspace}")
        seen_workspaces.add(workspace)
        layout = item.get("layout")
        if layout not in ("scrolling-tile", "vertical-scrolling-tile", "dwindle", "monocle", "floating"):
            raise ValueError(f"invalid workspace layout: {layout}")
        icon = require_text(item.get("icon", str(workspace)), "workspace icon", 65)
        name = str(item.get("name", "")).strip()
        if len(name) >= 129 or "\n" in name or "\r" in name:
            raise ValueError("workspace name is too long")
        line = f"workspace-{workspace} : {layout} : {icon}"
        if name:
            line += " : " + name
        lines.append(line)
    seen_outputs = set()
    for item in virtual_items:
        output = require_text(item.get("output"), "virtual screen output", 128)
        if output in seen_outputs:
            raise ValueError(f"duplicate virtual screen output: {output}")
        seen_outputs.add(output)
        ratio = integer(item.get("ratio"), "split ratio", 10, 90)
        offset = integer(item.get("offset", 0), "split offset", -100000, 100000)
        lines.append(f"virtual_screen : {output} : split : {ratio} : {offset}")

    rules = [item for item in document.get("rules", [])
             if item_source(item, root) == source]
    if rules:
        lines.extend(["", "# Window rules"])
    for item in rules:
        field = item.get("field")
        if field not in ("class", "instance", "title"):
            raise ValueError("rule field must be class, instance, or title")
        pattern = require_text(item.get("pattern"), "rule pattern", 512)
        effects = require_text(item.get("effects"), "rule effects", 512)
        lines.append(f"rule : {field} : {quote(pattern)} : {effects}")

    extras = [(raw, owners.get("extras", [])[index]
               if index < len(owners.get("extras", [])) else root)
              for index, raw in enumerate(document.get("extras", []))]
    if any(owner == source for _, owner in extras):
        lines.extend(["", "# Advanced entries preserved by anush"])
        for raw, owner in extras:
            if owner != source:
                continue
            lines.append(require_text(raw, "advanced entry", 4096))
    return "\n".join(lines) + "\n"


def serialize(document: dict) -> str:
    return serialize_source(document, str(document.get("path", active_path())))


def save(document: dict, reload_wm: bool) -> dict:
    path = active_path()
    if path is None:
        raise ValueError("No user configuration path is available")
    root = path.resolve()
    document["path"] = str(root)
    sources = [str(root)]
    for source in document.get("_sources", []):
        resolved = str(Path(source).resolve())
        if resolved not in sources:
            sources.append(resolved)
    baseline = document.get("_serialized", {})
    contents = {source: serialize_source(document, source) for source in sources}
    changed = [source for source in sources
               if contents[source] != baseline.get(source)]
    previous: dict[str, bytes | None] = {}
    modes: dict[str, int] = {}
    temporary_files: dict[str, Path] = {}
    try:
        for source in changed:
            target = Path(source)
            target.parent.mkdir(parents=True, exist_ok=True)
            previous[source] = target.read_bytes() if target.exists() else None
            modes[source] = target.stat().st_mode & 0o777 if target.exists() else 0o644
            descriptor, temporary_name = tempfile.mkstemp(
                prefix=f".{target.name}.", dir=target.parent)
            temporary = Path(temporary_name)
            temporary_files[source] = temporary
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                handle.write(contents[source])
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, modes[source])
        for source in changed:
            os.replace(temporary_files[source], Path(source))
        if reload_wm:
            command = shutil.which("skarwm-msg")
            if not command:
                raise RuntimeError("Saved, but skarwm-msg was not found")
            result = subprocess.run([command, "reload"], text=True,
                                    capture_output=True, timeout=8, check=False)
            if result.returncode != 0:
                detail = (result.stderr or result.stdout).strip()
                raise RuntimeError(detail or "skarwm rejected the configuration")
    except Exception:
        for temporary in temporary_files.values():
            temporary.unlink(missing_ok=True)
        for source, content in previous.items():
            target = Path(source)
            if content is None:
                target.unlink(missing_ok=True)
            else:
                target.write_bytes(content)
                os.chmod(target, modes[source])
        if reload_wm and shutil.which("skarwm-msg"):
            subprocess.run([shutil.which("skarwm-msg"), "reload"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        raise
    return parse(root)


def main() -> int:
    try:
        command = sys.argv[1] if len(sys.argv) > 1 else "read"
        path = active_path()
        if path is None:
            raise ValueError("Cannot determine skarwm configuration path")
        if command == "read":
            result = parse(path)
        elif command in ("save", "save-reload"):
            result = save(json.loads(sys.stdin.readline()), command == "save-reload")
        else:
            raise ValueError(f"Unknown command: {command}")
        print(json.dumps({"success": True, "document": result}, ensure_ascii=False))
        return 0
    except Exception as failure:
        print(json.dumps({"success": False, "error": str(failure)}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
