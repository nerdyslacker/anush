+int
+winisdock(Window w)
+{
+	Atom actual;
+	int format, result = 0;
+	unsigned char *data = NULL;
+	unsigned long count, remaining, i;
+
+	if (XGetWindowProperty(dpy, w, netatom[NetWMWindowType], 0L, 8L, False,
+		XA_ATOM, &actual, &format, &count, &remaining, &data) == Success && data) {
+		for (i = 0; i < count; i++)
+			if (((Atom *)data)[i] == netwmdock)
+				result = 1;
+		XFree(data);
+	}
+	return result;
+}
+
+int
+extbarremove(Window w)
+{
+	ExtBar *bar, **link;
+
+	for (link = &extbars; (bar = *link); link = &bar->next)
+		if (bar->win == w) {
+			*link = bar->next;
+			free(bar);
+			return 1;
+		}
+	return 0;
+}
+
+void
+updateextbars(void)
+{
+	Atom actual;
+	ExtBar *bar, **link;
+	Monitor *m;
+	XWindowAttributes wa;
+	int format;
+	unsigned char *data;
+	unsigned long count, remaining, *strut;
+	long left, right, top, bottom;
+
+	for (m = mons; m; m = m->next)
+		m->extbarleft = m->extbarright = m->extbartop = m->extbarbottom = 0;
+	for (link = &extbars; (bar = *link);) {
+		if (!XGetWindowAttributes(dpy, bar->win, &wa)) {
+			*link = bar->next;
+			free(bar);
+			continue;
+		}
+		left = right = top = bottom = 0;
+		data = NULL;
+		if (XGetWindowProperty(dpy, bar->win, netwmstrutpartial, 0L, 12L,
+			False, XA_CARDINAL, &actual, &format, &count, &remaining,
+			&data) == Success && data && count >= 4) {
+			strut = (unsigned long *)data;
+			left = strut[0]; right = strut[1];
+			top = strut[2]; bottom = strut[3];
+		}
+		if (data)
+			XFree(data);
+		if (!left && !right && !top && !bottom) {
+			data = NULL;
+			if (XGetWindowProperty(dpy, bar->win, netwmstrut, 0L, 4L,
+				False, XA_CARDINAL, &actual, &format, &count, &remaining,
+				&data) == Success && data && count >= 4) {
+				strut = (unsigned long *)data;
+				left = strut[0]; right = strut[1];
+				top = strut[2]; bottom = strut[3];
+			}
+			if (data)
+				XFree(data);
+		}
+		m = recttomon(wa.x, wa.y, wa.width, wa.height);
+		if (left)
+			m->extbarleft = MAX(m->extbarleft, (int)left - m->mx);
+		if (right)
+			m->extbarright = MAX(m->extbarright,
+				(int)right - (sw - m->mx - m->mw));
+		if (top)
+			m->extbartop = MAX(m->extbartop, (int)top - m->my);
+		if (bottom)
+			m->extbarbottom = MAX(m->extbarbottom,
+				(int)bottom - (sh - m->my - m->mh));
+		link = &bar->next;
+	}
+	for (m = mons; m; m = m->next) {
+		updatebarpos(m);
+		arrange(m);
+	}
+}
