+static void snap_move_to_pointer_edge(ObClient *client)
+{
+    const Rect *physical;
+    Rect *area;
+    guint monitor;
+    gint px, py, x, y, w, h, logical_w, logical_h;
+    gboolean left, right, top;
+
+    if (!screen_pointer_pos(&px, &py))
+        return;
+
+    monitor = screen_find_monitor_point(px, py);
+    physical = screen_physical_area_monitor(monitor);
+    area = screen_area(client->desktop, monitor, NULL);
+    left = px <= physical->x + EDGE_SNAP_DISTANCE;
+    right = px >= RECT_RIGHT(*physical) - EDGE_SNAP_DISTANCE;
+    top = py <= physical->y + EDGE_SNAP_DISTANCE;
+
+    if (!left && !right && !top) {
+        g_slice_free(Rect, area);
+        return;
+    }
+
+    if (top && !left && !right) {
+        client_maximize(client, TRUE, 0);
+        g_slice_free(Rect, area);
+        return;
+    }
+
+    w = area->width / 2;
+    h = area->height;
+    x = left ? area->x : area->x + area->width - w;
+    y = area->y;
+    w -= client->frame->size.left + client->frame->size.right;
+    h -= client->frame->size.top + client->frame->size.bottom;
+
+    frame_frame_gravity(client->frame, &x, &y);
+    client_try_configure(client, &x, &y, &w, &h,
+                         &logical_w, &logical_h, TRUE);
+    client_configure(client, x, y, w, h, TRUE, TRUE, FALSE);
+    g_slice_free(Rect, area);
+}
