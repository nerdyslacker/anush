+void
+updateanushstate(void)
+{
+	Client *c;
+	char *layoutnames, *write;
+	size_t length = 0;
+	unsigned int i;
+	unsigned long state[4] = { selmon->tagset[selmon->seltags], 0, 0, 0 };
+
+	for (c = selmon->clients; c; c = c->next) {
+		state[1] |= c->tags;
+		if (c->isurgent)
+			state[2] |= c->tags;
+	}
+	for (i = 0; i < LENGTH(layouts); i++) {
+		if (selmon->lt[selmon->sellt] == &layouts[i]) {
+			state[3] = i;
+			break;
+		}
+	}
+	XChangeProperty(dpy, root, anushstate, XA_CARDINAL, 32,
+		PropModeReplace, (unsigned char *)state, LENGTH(state));
+	for (i = 0; i < LENGTH(layouts); i++)
+		length += strlen(layouts[i].symbol) + (i > 0);
+	layoutnames = write = ecalloc(length + 1, sizeof(char));
+	for (i = 0; i < LENGTH(layouts); i++) {
+		if (i > 0)
+			*write++ = '\t';
+		memcpy(write, layouts[i].symbol, strlen(layouts[i].symbol));
+		write += strlen(layouts[i].symbol);
+	}
+	XChangeProperty(dpy, root, anushlayouts, XA_STRING, 8,
+		PropModeReplace, (unsigned char *)layoutnames, length);
+	free(layoutnames);
+}
+
 /* There's no way to check accesses to destroyed windows, thus those cases are
