#!/bin/sh

herbstclient emit_hook reload
herbstclient rename default 1
herbstclient add 2
herbstclient add 3
herbstclient add 4
herbstclient add 5
herbstclient add 6
herbstclient add 7
herbstclient add 8
herbstclient add 9
herbstclient set frame_gap 8
