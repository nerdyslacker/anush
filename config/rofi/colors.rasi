/* Generated from wallpaper: hadrut_dark.jpeg */

* {
    bg:          #291c25;
    fg:          #d2cbbc;
    accent:      #ad9f97;
    accent-2:    #c29fc6;
    border:      #ad9f97;
    urgent:      #cb8a86;
    selected-fg: #291c25;
    entry-fg:    #c29fc6;
    prompt-fg:   #ad9f97;
    header:      #c29fc6;
    background-color: @bg;
}
